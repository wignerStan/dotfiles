{{- /* Reconcile mamba base env against .chezmoidata/mamba_base.toml.
     Renders environment.yaml, then mamba env update.
     use_uv: true in .condarc enables uv for pip installs where available. */ -}}
{{- if and (ne .chezmoi.os "windows") (eq .bootstrap "full") (lookPath "micromamba") (and (ne .tier "simple") (not (has "hpc" .facets))) -}}
{{- /* Resolved per-user machine profile; empty means user-local caches. */ -}}
{{- $shared := "" -}}
{{- if hasKey . "shared_workspace" }}{{- $shared = .shared_workspace | default "" }}{{- end -}}
#!/bin/sh
set -eu
export MAMBA_ROOT_PREFIX="{{ .mamba_root }}"
export CONDA_PREFIX="{{ .mamba_root }}"
export UV_SYSTEM_PYTHON=1
export UV_LINK_MODE=clone{{- if $shared }}
export UV_CACHE_DIR="{{ $shared }}/.cache/uv"{{- end }}
log() { printf '[mamba-sync] %s\n' "$*"; }

MM="$(command -v micromamba 2>/dev/null || command -v mamba 2>/dev/null || command -v conda 2>/dev/null || true)"
[ -z "$MM" ] && { log "no micromamba/mamba/conda found, skipping"; exit 0; }

# Render environment.yaml
ENV_YAML="$(mktemp /tmp/mamba-base-env.XXXXXX.yaml)"
trap 'rm -f "$ENV_YAML"' EXIT
cat > "$ENV_YAML" << 'YAMLEOF'
name: base
channels:
{{- range .mamba_base.channels }}
  - {{ . }}
{{- end }}
dependencies:
  - uv
{{- range .mamba_sections }}
{{-   $sec := . }}
{{-   range (index $.mamba_base $sec).conda }}
  - {{ . }}
{{-   end }}
{{- end }}
{{- $pip := list -}}
{{- range .mamba_sections }}
{{-   $pip = concat $pip (index $.mamba_base .).pip }}
{{- end }}
{{- if $pip }}
  - pip:
{{- range $pip }}
    - {{ . }}
{{- end }}
{{- end }}
YAMLEOF

if [ -f "$MAMBA_ROOT_PREFIX/conda-meta/history" ]; then
    log "updating base env (tier={{ .tier }} sections={{ .mamba_sections | join "," }})..."
    "$MM" env update -y -p "$MAMBA_ROOT_PREFIX" -f "$ENV_YAML" --use-uv 2>&1 \
        || log "mamba env update reported errors"
else
    log "creating base env (tier={{ .tier }} sections={{ .mamba_sections | join "," }})..."
    "$MM" env create -y -p "$MAMBA_ROOT_PREFIX" -f "$ENV_YAML" --use-uv 2>&1 \
        || log "mamba env create reported errors"
fi

log "base sync complete (tier={{ .tier }})"

# ── Develop env (separate from base) — dev facet ───────────────
{{- if has "dev" .facets }}
DEV_YAML="$(mktemp /tmp/mamba-dev-env.XXXXXX.yaml)"
trap 'rm -f "$ENV_YAML" "$DEV_YAML"' EXIT
cat > "$DEV_YAML" << 'YAMLEOF'
name: develop
channels:
{{- range .mamba_base.channels }}
  - {{ . }}
{{- end }}
dependencies:
  - uv
  - python=3.12
  - pip
{{- if hasKey .mamba_base "dev" }}
{{- range (index .mamba_base "dev").conda }}
  - {{ . }}
{{- end }}
{{- if (index .mamba_base "dev").pip }}
  - pip:
{{- range (index .mamba_base "dev").pip }}
    - {{ . }}
{{- end }}
{{- end }}
{{- end }}
YAMLEOF

log "creating/updating develop env..."
DEV_ENV="{{ .chezmoi.homeDir }}/.conda/envs/develop"
    if [ ! -d "$DEV_ENV" ]; then
        "$MM" env create -f "$DEV_YAML" -y --use-uv --prefix "$DEV_ENV" 2>&1 || log "develop env create reported errors"
else
    "$MM" env update -p "$DEV_ENV" -f "$DEV_YAML" --use-uv 2>&1 || log "develop env update reported errors"
fi
log "develop env sync complete"
{{- end }}

{{- end -}}
