{{- /* Reconcile mamba base env against .chezmoidata/mamba_base.toml.
     Renders environment.yaml, then mamba env update.
     use_uv: true in .condarc enables uv for pip installs where available. */ -}}
{{- if and (lookPath "micromamba") (and (ne .tier "calculate") (ne .tier "simple")) -}}
#!/bin/sh
set -eu
export MAMBA_ROOT_PREFIX="{{ .mamba_root }}"
export CONDA_PREFIX="{{ .mamba_root }}"
export UV_SYSTEM_PYTHON=1
export UV_CACHE_DIR="{{- if eq .chezmoi.os "linux" -}}/develop/.cache/uv{{- else -}}$HOME/.cache/uv{{- end -}}"
log() { printf '[mamba-sync] %s\n' "$*"; }

MM="$(command -v micromamba 2>/dev/null || command -v mamba 2>/dev/null || command -v conda 2>/dev/null || true)"
[ -z "$MM" ] && { log "no micromamba/mamba/conda found, skipping"; exit 0; }
case "$MM" in *micromamba|*mamba) "$MM" env list 2>/dev/null | grep -qw base || { log "base env not present, skipping"; exit 0; } ;; esac

# Render environment.yaml
ENV_YAML="$(mktemp /tmp/mamba-base-env.XXXXXX.yaml)"
trap 'rm -f "$ENV_YAML"' EXIT
cat > "$ENV_YAML" << 'YAMLEOF'
name: base
channels:
{{- range .mamba_base.channels }}
  - {{ . }}
{{- end }}
dependencies:
  - uv
{{- range .mamba_base.core.conda }}
  - {{ . }}
{{- end }}
{{- $tier_data := dict "conda" (list) "pip" (list) -}}
{{- if hasKey .mamba_base .tier -}}
{{-   $tier_data = index .mamba_base .tier -}}
{{- end -}}
{{- range $tier_data.conda }}
  - {{ . }}
{{- end }}
{{- if or .mamba_base.core.pip $tier_data.pip }}
  - pip:
{{- range .mamba_base.core.pip }}
    - {{ . }}
{{- end }}
{{- range $tier_data.pip }}
    - {{ . }}
{{- end }}
{{- end }}
YAMLEOF

log "running mamba env update (tier={{ .tier }})..."
"$MM" env update -n base -f "$ENV_YAML" --use-uv 2>&1 || log "mamba env update reported errors"

log "base sync complete (tier={{ .tier }})"

# ── Develop env (separate from base) ───────────────────────────
{{- if eq .tier "develop" }}
DEV_YAML="$(mktemp /tmp/mamba-dev-env.XXXXXX.yaml)"
trap 'rm -f "$ENV_YAML" "$DEV_YAML"' EXIT
cat > "$DEV_YAML" << 'YAMLEOF'
name: develop
channels:
{{- range .mamba_base.channels }}
  - {{ . }}
{{- end }}
dependencies:
  - uv
  - python=3.12
  - pip
{{- if hasKey .mamba_base "develop" }}
{{- range (index .mamba_base "develop").conda }}
  - {{ . }}
{{- end }}
{{- if (index .mamba_base "develop").pip }}
  - pip:
{{- range (index .mamba_base "develop").pip }}
    - {{ . }}
{{- end }}
{{- end }}
{{- end }}
YAMLEOF

log "creating/updating develop env..."
DEV_ENV="{{ .chezmoi.homeDir }}/.conda/envs/develop"
    if [ ! -d "$DEV_ENV" ]; then
        "$MM" env create -f "$DEV_YAML" -y --use-uv --prefix "$DEV_ENV" 2>&1 || log "develop env create reported errors"
else
    "$MM" env update -p "$DEV_ENV" -f "$DEV_YAML" --use-uv 2>&1 || log "develop env update reported errors"
fi
log "develop env sync complete"
{{- end }}

{{- end -}}
