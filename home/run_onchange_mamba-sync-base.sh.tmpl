{{- /* Reconcile the mamba base env against .chezmoidata/mamba_base.toml.
     mamba install with use_uv: true in .condarc handles pip deps via uv. */ -}}
{{- if lookPath "micromamba" -}}
#!/bin/sh
set -eu
export MAMBA_ROOT_PREFIX="{{ .mamba_root }}"
log() { printf '[mamba-sync] %s\n' "$*"; }

MM="$(command -v micromamba 2>/dev/null || command -v mamba 2>/dev/null || command -v conda 2>/dev/null || true)"
[ -z "$MM" ] && { log "no micromamba/mamba/conda found, skipping"; exit 0; }
case "$MM" in *micromamba|*mamba) "$MM" env list 2>/dev/null | grep -qw base || { log "base env not present, skipping"; exit 0; } ;; esac

CHANNELS="{{ range .mamba_base.channels }} -c {{ . }}{{ end }}"
CONDA_PKGS="{{ range .mamba_base.core.conda }}{{ . }} {{ end }}{{ range (index .mamba_base .tier).conda }}{{ . }} {{ end }}"
PIP_PKGS="{{ range .mamba_base.core.pip }}{{ . }} {{ end }}{{ range (index .mamba_base .tier).pip }}{{ . }} {{ end }}"

if [ -n "${CONDA_PKGS:-}" ]; then
    log "installing conda packages (tier={{ .tier }}): ${CONDA_PKGS}"
    # shellcheck disable=SC2086
    "$MM" install -y -n base ${CHANNELS} ${CONDA_PKGS} >/dev/null 2>&1 || log "conda install reported errors"
fi

if [ -n "${PIP_PKGS:-}" ]; then
    log "installing pip packages (tier={{ .tier }}): ${PIP_PKGS}"
    # shellcheck disable=SC2086
    "$MM" install -y -n base ${PIP_PKGS} >/dev/null 2>&1 || log "mamba install pip packages reported errors"
fi

log "sync complete (tier={{ .tier }})"
{{- end -}}
