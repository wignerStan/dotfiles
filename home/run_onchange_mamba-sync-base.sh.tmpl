{{- /* Reconcile the mamba base env against .chezmoidata/mamba_base.toml.
     Renders an environment.yaml, then mamba installs from it with --use-uv.
     Idempotent (only ADDS). Uses uv for pip packages (reflink support). */ -}}
{{- if lookPath "micromamba" -}}
#!/bin/sh
set -eu
export MAMBA_ROOT_PREFIX="{{ .mamba_root }}"
export UV_CACHE_DIR="{{- if eq .chezmoi.os "linux" -}}/develop/.cache/uv{{- else -}}$HOME/.cache/uv{{- end -}}"
log() { printf '[mamba-sync] %s\n' "$*"; }

MM="$(command -v micromamba 2>/dev/null || command -v mamba 2>/dev/null || command -v conda 2>/dev/null || true)"
[ -z "$MM" ] && { log "no micromamba/mamba/conda found, skipping"; exit 0; }
case "$MM" in *micromamba|*mamba) "$MM" env list 2>/dev/null | grep -qw base || { log "base env not present, skipping"; exit 0; } ;; esac

# Render environment.yaml
ENV_YAML="$(mktemp /tmp/mamba-base-env.XXXXXX.yaml)"
trap 'rm -f "$ENV_YAML"' EXIT
cat > "$ENV_YAML" << 'YAMLEOF'
name: base
channels:
{{- range .mamba_base.channels }}
  - {{ . }}
{{- end }}
dependencies:
{{- range .mamba_base.core.conda }}
  - {{ . }}
{{- end }}
{{- range (index .mamba_base .tier).conda }}
  - {{ . }}
{{- end }}
{{- if or .mamba_base.core.pip (index .mamba_base .tier).pip }}
  - pip:
{{- range .mamba_base.core.pip }}
    - {{ . }}
{{- end }}
{{- range (index .mamba_base .tier).pip }}
    - {{ . }}
{{- end }}
{{- end }}
YAMLEOF

log "rendered environment.yaml for tier={{ .tier }}"
cat "$ENV_YAML"

log "running mamba env update (tier={{ .tier }})..."
"$MM" env update -n base -f "$ENV_YAML" --use-uv >/dev/null 2>&1 || log "mamba env update reported errors"

log "sync complete (tier={{ .tier }})"
{{- end -}}
