# sing-box: personal desktop only (macOS/Windows — runs TUN proxy there).
# Also skip in guest VMs: the TUN proxy runs on the Mac host, not the VM
# (the VM rides the host's network), and the Homebrew/sing-box run_*.sh scripts
# can't fork/exec on Windows.
{{- if or (not (eq .profile "personal")) (eq .chezmoi.os "linux") (eq .tier "simple") }}
.config/sing-box/
{{- end }}

{{- if (eq .tier "simple") }}
# VM: skip host-only daemons, Unix shells, and Homebrew integration entirely.
# The VM is Windows-only (apps with no Mac version); it rides the host Mac's
# TUN proxy and uses PowerShell. Unix-shell templates (fish/zsh/tmux/sing-box)
# call Unix-only commands (id, brew) and have no meaning in the guest.
.config/homebrew/
.config/sing-box/
.config/zellij/
.config/yazi/
.config/ghostty/
.config/tmux/
.config/fish/
.config/nushell/
.oh-my-zsh/
.zshrc
.zshenv
.zprofile
.iterm2_shell_integration.zsh
{{- end }}

# Byobu: Linux-only
{{- if not (eq .chezmoi.os "linux") }}
.config/byobu/
{{- end }}

{{- if eq .profile "hpc" }}
# HPC: skip workstation-only tools, use container-data/zsh instead
.config/ghostty/
.config/zellij/
.config/yazi/
.oh-my-zsh/
.iterm2_shell_integration.zsh

# Shell configs — HPC uses container-data/zsh/ instead
.zshenv
.zshrc
.zprofile

# Scripts — require Homebrew/GitHub access
bootstrap.sh
reload-configs.sh
install-yazi-plugins.sh
{{- else if .is_headless }}
# Headless (non-HPC): skip GUI tools only
.config/ghostty/
.config/zellij/
.config/yazi/
.oh-my-zsh/
.iterm2_shell_integration.zsh
{{- end }}

# container-data: only on HPC
{{- if ne .profile "hpc" }}
container-data/
{{- end }}

# Node/Bun/Go/Pixi configs: develop tier only
{{- if ne .tier "develop" }}
.npmrc
.bunfig.toml
.config/go/
.config/pixi/
{{- end }}

# uv/pixi shared cache: only personal+linux+standard (bare metal with /develop)
{{- if not (and (eq .profile "personal") (eq .chezmoi.os "linux") (eq .tier "standard")) }}
.config/uv/
.config/pixi/
{{- end }}

# mamba base-env sync USER SERVICE — opt-in (mamba_sync_service).
# The sync scripts (.local/bin/mamba-sync-base.*) deploy wherever mamba exists,
# so you can run them manually. But the auto-running service (LaunchAgent plist /
# Windows scheduled-task registration) only deploys when explicitly enabled.
{{- if not (hasKey . "mamba_sync_service") }}
Library/LaunchAgents/com.jacob.mamba-sync-base.plist
run_onchange_mamba-sync-service-enable.ps1.tmpl
{{- end }}
