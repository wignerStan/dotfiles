{{- $axesValidated := includeTemplate "validate-axes" . -}}
# Platform-specific script trees must never be rendered onto another OS.
{{- if ne .chezmoi.os "windows" }}
scripts/winvm/
{{- end }}
{{- if not (and (eq .chezmoi.os "darwin") (has "dev" .facets)) }}
scripts/tartvm/
{{- end }}
{{- if ne .chezmoi.os "darwin" }}
Library/
{{- end }}

# sing-box: personal macOS/Windows desktop only. Explicit guests ride the host
# network; resource tier alone does not imply guest placement.
{{- if or (not (eq .ownership "personal")) (eq .chezmoi.os "linux") .is_guest }}
.config/sing-box/
{{- end }}

{{- $pfBasicLayer := or (eq .bootstrap "basic") (eq .bootstrap "full") -}}
{{- $pfManaged := and (eq .ownership "personal") (eq .chezmoi.os "darwin") $pfBasicLayer -}}
{{- if not $pfManaged }}
# PF staging is a personal macOS L2/basic resource. Installation remains
# system-scoped, but user applies keep these immutable inputs current.
.config/pf/
{{- end }}

{{- if (eq .tier "simple") }}
# Minimal tier: skip optional Unix shells and desktop integrations. Guest-only
# network behavior is controlled separately by .is_guest above.
.config/homebrew/
.config/zellij/
.config/yazi/
.config/ghostty/
.config/tmux/
.config/fish/
.config/nushell/
.oh-my-zsh/
.zshrc
.zshenv
.zprofile
.iterm2_shell_integration.zsh
{{- end }}

# Byobu: Linux-only
{{- if not (eq .chezmoi.os "linux") }}
.config/byobu/
{{- end }}

# Zellij: Linux/WSL only (not darwin)
{{- if not (or (eq .chezmoi.os "linux") (eq .os_platform "wsl")) }}
.config/zellij/
{{- end }}

{{- if has "hpc" .facets }}
# HPC: skip workstation-only tools, use container-data/zsh instead
.config/ghostty/
.config/zellij/
.config/yazi/
.oh-my-zsh/
.iterm2_shell_integration.zsh

# Shell configs — HPC uses container-data/zsh/ instead
.zshenv
.zshrc
.zprofile

# Scripts — require Homebrew/GitHub access
bootstrap.sh
reload-configs.sh
install-yazi-plugins.sh
{{- else if .is_headless }}
# Headless (non-HPC): skip GUI tools only
.config/ghostty/
.iterm2_shell_integration.zsh
{{- end }}

# container-data: only on HPC (hpc facet)
{{- if not (has "hpc" .facets) }}
container-data/
{{- end }}

# Node/Bun/Go configs: dev facet only
{{- if not (has "dev" .facets) }}
.bunfig.toml
.config/go/
{{- end }}
# Pixi config: research facet only
{{- if not (has "research" .facets) }}
.config/pixi/
{{- end }}
