{{- /* Unix-only bootstrap (Homebrew). Windows uses run_onchange_windows-bootstrap.ps1. */ -}}
{{- if not (eq .tier "simple") -}}
#!/bin/bash

# ═══════════════════════════════════════════════════════════════
# Jacob's Multi-Machine Bootstrap v4 — profile-aware
# ═══════════════════════════════════════════════════════════════

set -euo pipefail

echo "=== Starting Jacob's Dotfiles Bootstrap (profile={{ .profile }} tier={{ .tier }}) ==="

# 1. Mirror-aware Homebrew setup
{{- if .use_china_mirrors }}
export HOMEBREW_BREW_GIT_REMOTE="https://mirrors.ustc.edu.cn/brew.git"
export HOMEBREW_CORE_GIT_REMOTE="https://mirrors.ustc.edu.cn/homebrew-core.git"
export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.ustc.edu.cn/homebrew-bottles"
export HOMEBREW_API_DOMAIN="https://mirrors.ustc.edu.cn/homebrew-bottles/api"
{{- end }}

# ── Homebrew detection (skip install on work — usually no sudo) ─
if ! command -v brew &> /dev/null; then
    if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
        eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    elif [[ -x /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    fi
fi

# ── npm global block (non-work profiles) ───────────────────────
{{- if and (ne .tier "simple") (not (eq .profile "work")) }}
mkdir -p "$HOME/.npm-global-blocked"
chmod -R 0500 "$HOME/.npm-global-blocked"
{{- end }}

{{- if or (or (eq .profile "work") (eq .profile "vps")) (eq .profile "hpc") }}
# Work/VPS profile: no Homebrew. Probe for core tools and install
# missing ones as static binaries from GitHub releases into ~/.local/bin.
{{- if eq .profile "vps" }}
# ═══ VPS: distro-aware system packages + services ═════════════
__vps_pkgs=""
__vps_init=""

if command -v apk &>/dev/null; then
    # Alpine
    __vps_pkgs="zsh tmux git curl openssh ripgrep fd fzf bat neovim"
    echo "Installing core packages via apk..."
    sudo apk add --no-cache $__vps_pkgs 2>/dev/null || true
    # rc-service for Alpine OpenRC
    __vps_init="openrc"
elif command -v apt &>/dev/null; then
    # Debian/Ubuntu
    __vps_pkgs="zsh tmux git curl ripgrep fd-find fzf bat neovim"
    echo "Installing core packages via apt..."
    sudo apt update -qq && sudo apt install -y $__vps_pkgs 2>/dev/null || true
    __vps_init="systemd"
fi

# ── Git config ────────────────────────────────────────────────
if ! git config --global user.name &>/dev/null; then
    git config --global user.name "{{ .name }}"
    git config --global user.email "{{ .email }}"
    git config --global init.defaultBranch main
    git config --global pull.rebase true
    echo "Git configured"
fi

# ── Tailscale ─────────────────────────────────────────────────
if ! command -v tailscale &>/dev/null; then
    echo "Installing Tailscale..."
    if [[ "$__vps_init" == "openrc" ]]; then
        # Alpine: install from edge community repo
        sudo apk add --no-cache --repository=http://dl-cdn.alpinelinux.org/alpine/edge/community tailscale 2>/dev/null || true
        # OpenRC: enable and start tailscale service
        sudo rc-update add tailscale default 2>/dev/null
        sudo rc-service tailscale start 2>/dev/null
    else
        curl -fsSL https://tailscale.com/install.sh | sh 2>/dev/null
        sudo systemctl enable --now tailscaled 2>/dev/null
    fi
fi
# Ensure tailscale is up with --accept-dns=false (use VPS resolver, not Tailscale DNS)
if command -v tailscale &>/dev/null; then
    if ! tailscale status &>/dev/null 2>&1; then
        echo "Tailscale not authenticated. Run: sudo tailscale up --accept-dns=false"
    else
        # Already up — re-apply with --accept-dns=false if not set
        __ts_dns=$(tailscale debug prefs 2>/dev/null | grep -c '"AcceptDNS":\[false\]' || echo 0)
        if [[ "$__ts_dns" == "0" ]]; then
            echo "Applying --accept-dns=false to Tailscale..."
            sudo tailscale up --accept-dns=false --reset=false 2>/dev/null || true
        fi
    fi
fi

# ── OpenRC service hardening (Alpine) ─────────────────────────
if [[ "$__vps_init" == "openrc" ]]; then
    # Ensure critical services are enabled at boot
    for svc in sshd tailscale networking; do
        sudo rc-update add $svc default 2>/dev/null
    done
    echo "OpenRC services enabled: sshd tailscale networking"
fi

# ── Kopia backup ──────────────────────────────────────────────
if ! command -v kopia &>/dev/null; then
    echo "Installing Kopia..."
    if [[ "$__vps_init" == "openrc" ]]; then
        # Alpine: download static binary
        __kopia_ver=$(curl -fsSL https://api.github.com/repos/kopia/kopia/releases/latest | grep -oP '"tag_name": "v\K[^"]+')
        curl -fsSL "https://github.com/kopia/kopia/releases/download/v${__kopia_ver}/kopia-${__kopia_ver}-linux-x86_64.tar.gz" \
            | sudo tar xz -C /usr/local/bin --strip-components=1 kopia-${__kopia_ver}-linux-x86_64/kopia 2>/dev/null
    else
        curl -fsSL https://kopia.io/signing-key | sudo gpg --dearmor -o /usr/share/keyrings/kopia-keyring.gpg 2>/dev/null
        echo "deb [signed-by=/usr/share/keyrings/kopia-keyring.gpg] http://packages.kopia.io/apt/ stable main" | sudo tee /etc/apt/sources.list.d/kopia.list >/dev/null
        sudo apt update -qq && sudo apt install -y kopia 2>/dev/null
    fi
fi

# ── SSH hardening ─────────────────────────────────────────────
__sshd_config="/etc/ssh/sshd_config"
if [[ -f "$__sshd_config" ]]; then
    echo "Hardening sshd..."
    sudo sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin prohibit-password/' "$__sshd_config"
    sudo sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' "$__sshd_config"
    sudo sed -i 's/^#\?PubkeyAuthentication.*/PubkeyAuthentication yes/' "$__sshd_config"
    sudo sed -i 's/^#\?MaxAuthTries.*/MaxAuthTries 3/' "$__sshd_config"
    if [[ "$__vps_init" == "openrc" ]]; then
        sudo rc-service sshd reload 2>/dev/null || true
    else
        sudo systemctl reload sshd 2>/dev/null || sudo systemctl reload ssh 2>/dev/null || true
    fi
    echo "sshd hardened: root=prohibit-password, password=no, pubkey=yes"
fi
{{- end }}

echo "{{ .profile | title }} profile: probing for core tools..."
mkdir -p "$HOME/.local/bin"

# Helper: detect arch and OS for GitHub release downloads
__get_arch() {
    case "$(uname -m)" in
        x86_64)  echo "x86_64" ;;
        aarch64|arm64) echo "arm64" ;;
        *) echo "$(uname -m)" ;;
    esac
}
ARCH=$(__get_arch)
OS=$(uname -s | tr '[:upper:]' '[:lower:]')

# Probe and install missing core tools from GitHub
# starship (starship/starship)
if ! command -v starship &>/dev/null; then
    echo "Installing starship from GitHub..."
    curl -fsSL "https://github.com/starship/starship/releases/latest/download/starship-${ARCH}-${OS}.gz"         | gunzip > "$HOME/.local/bin/starship" && chmod +x "$HOME/.local/bin/starship"
fi

# zoxide (ajitid/zoxide)
if ! command -v zoxide &>/dev/null; then
    echo "Installing zoxide from GitHub..."
    curl -fsSL "https://github.com/ajitid/zoxide/releases/latest/download/zoxide-${ARCH}-${OS/-/_}.tar.gz"         | tar xz -C "$HOME/.local/bin" zoxide 2>/dev/null || echo "Warning: zoxide install failed, skipping"
fi

# eza (eza-community/eza)
if ! command -v eza &>/dev/null; then
    echo "Installing eza from GitHub..."
    __eza_arch="x86_64"
    [[ "$ARCH" == "arm64" ]] && __eza_arch="aarch64"
    curl -fsSL "https://github.com/eza-community/eza/releases/latest/download/eza_${__eza_arch}-${OS}-gnu.tar.gz"         | tar xz -C "$HOME/.local/bin" eza 2>/dev/null || echo "Warning: eza install failed, skipping"
fi

# bat (sharkdp/bat)
if ! command -v bat &>/dev/null; then
    echo "Installing bat from GitHub..."
    __bat_arch="$ARCH"
    [[ "$ARCH" == "x86_64" ]] && __bat_arch="x86_64"
    curl -fsSL "https://github.com/sharkdp/bat/releases/latest/download/bat-v$(curl -fsSL https://api.github.com/repos/sharkdp/bat/releases/latest | grep -oP '"tag_name": "v\K[^"]+')-${__bat_arch}-${OS}.tar.gz"         | tar xz --strip-components=1 -C "$HOME/.local/bin" "*/bat" 2>/dev/null || echo "Warning: bat install failed, skipping"
fi

# ripgrep (BurntSushi/ripgrep)
if ! command -v rg &>/dev/null; then
    echo "Installing ripgrep from GitHub..."
    curl -fsSL "https://github.com/BurntSushi/ripgrep/releases/latest/download/ripgrep-$(curl -fsSL https://api.github.com/repos/BurntSushi/ripgrep/releases/latest | grep -oP '"tag_name": "\K[^"]+')-${ARCH}-${OS}.tar.gz"         | tar xz --strip-components=1 -C "$HOME/.local/bin" "*/rg" 2>/dev/null || echo "Warning: ripgrep install failed, skipping"
fi

# fd (sharkdp/fd)
if ! command -v fd &>/dev/null; then
    echo "Installing fd from GitHub..."
    curl -fsSL "https://github.com/sharkdp/fd/releases/latest/download/fd-v$(curl -fsSL https://api.github.com/repos/sharkdp/fd/releases/latest | grep -oP '"tag_name": "v\K[^"]+')-${ARCH}-${OS}.tar.gz"         | tar xz --strip-components=1 -C "$HOME/.local/bin" "*/fd" 2>/dev/null || echo "Warning: fd install failed, skipping"
fi

# fzf (junegunn/fzf)
if ! command -v fzf &>/dev/null; then
    echo "Installing fzf from GitHub..."
    curl -fsSL "https://github.com/junegunn/fzf/releases/latest/download/fzf-${ARCH}-${OS}.tar.gz"         | tar xz -C "$HOME/.local/bin" fzf 2>/dev/null || echo "Warning: fzf install failed, skipping"
fi

# fastfetch (fastfetch-cli/fastfetch)
if ! command -v fastfetch &>/dev/null; then
    echo "Installing fastfetch from GitHub..."
    __ff_arch="x86_64"
    [[ "$ARCH" == "arm64" ]] && __ff_arch="aarch64"
    curl -fsSL "https://github.com/fastfetch-cli/fastfetch/releases/latest/download/fastfetch-${__ff_arch}-linux.tar.gz"         | tar xz --strip-components=2 -C "$HOME/.local/bin" "fastfetch/usr/bin/fastfetch" 2>/dev/null || echo "Warning: fastfetch install failed, skipping"
fi

echo "{{ .profile | title }} profile: core tool probe complete"
{{- else }}
# Install Homebrew if missing
if ! command -v brew &> /dev/null; then
    echo "Homebrew not found. Installing..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# ── Core CLI tools (all non-simple/work/vps profiles) ─────────
echo "Installing core CLI tools..."
core_packages=(
    zsh
    tmux
    starship
    zoxide
    eza
    bat
    ripgrep
    fd
    neovim
    age
    fastfetch
    fzf
    zellij
    stylua
    luarocks
    just
    shellcheck
    shfmt
    lefthook
)

for pkg in "${core_packages[@]}"; do
    brew install "$pkg" 2>/dev/null || echo "Warning: failed to install $pkg, skipping"
done

# ── Basic language tools (default for all brew-capable profiles) ──
echo "Installing basic language tools..."
lang_tools=(
    uv
    ruff
    pyright
    micromamba
    node
    pnpm
    bun
    biome
    perl
)

for pkg in "${lang_tools[@]}"; do
    brew install "$pkg" 2>/dev/null || echo "Warning: failed to install $pkg, skipping"
done

{{- if and (eq .chezmoi.os "linux") (eq .profile "personal") }}
# ── Personal Linux: develop + calculate users, shared brew ────
# jacob (standard) manages brew; dev and cal use it via group access.
# Additional runtimes for personal Linux:
linux_extra=(
    deno
    zig
    pixi
)
for pkg in "${linux_extra[@]}"; do
    brew install "$pkg" 2>/dev/null || echo "Warning: failed to install $pkg, skipping"
done

# Per-user language toolchains (NOT via brew)
# Go: native multi-version via go install (per-user ~/.go or ~/go)
if ! command -v go &>/dev/null; then
    echo "Installing go (per-user)..."
    GO_VERSION="1.24.5"
    curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" | tar xz -C "$HOME/.local" 2>/dev/null || echo "Warning: go install failed"
fi
# Rust: per-user via rustup
if ! command -v cargo &>/dev/null; then
    echo "Installing rustup (per-user)..."
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y 2>/dev/null || echo "Warning: rustup install failed"
fi

# ── Auto-create dev and cal users ─────────────────────────────
# dev: full develop workspace at /develop
# cal: user-isolated workspace, real workspace projects
for u in dev cal; do
    if ! id -u "$u" &>/dev/null; then
        echo "Creating user: $u"
        home_dir="/$u"
        [ "$u" = "dev" ] && home_dir="/develop"
        sudo useradd -m -d "$home_dir" -s /home/linuxbrew/.linuxbrew/bin/zsh "$u" 2>/dev/null || echo "Warning: failed to create $u"
        # Add to dev group for shared /develop access
        sudo usermod -aG dev "$u" 2>/dev/null || true
    fi
    # Ensure shell is zsh
    sudo chsh -s /home/linuxbrew/.linuxbrew/bin/zsh "$u" 2>/dev/null || true
done

{{- end }}

# ── Desktop tools (macOS) ─────────────────────────────────────
{{- if eq .chezmoi.os "darwin" }}
brew install pixi fish nushell ghostty kubecolor 2>/dev/null || echo "Warning: some macOS packages failed"
{{- end }}

{{- end }}

echo "=== Bootstrap Complete ==="
{{- end -}}
