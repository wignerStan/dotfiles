  fi
  return $ret
}

mamba() {
    case "${1-}" in
        env)
            cat >&2 << 'EOF'
╔═══════════════════════════════════════════════════════════════════════════╗
║                     🛑  STOP USING MAMBA ENV  🛑                           ║
╚═══════════════════════════════════════════════════════════════════════════╝

This wrapper intercepts 'mamba env' to teach you pixi for project environments.

WHY THIS WRAPPER EXISTS:
─────────────────────────
  • pixi UNIFIES conda-forge (pre-compiled) + PyPI (via uv) in ONE project
  • Replaces BOTH conda/mamba env AND .venv with a single workflow
  • Workspace-based: one folder contains manifest, lock file, environments
  • Built-in task runner, lock files, multi-environment support

═══════════════════════════════════════════════════════════════════════════
  QUICK START (Python project example)
═══════════════════════════════════════════════════════════════════════════

  pixi init myproject && cd myproject
  pixi add python numpy pandas           # conda-forge packages (fast, pre-compiled)
  pixi add --pypi requests               # PyPI-only packages via uv
  pixi shell                             # Activate environment
  pixi run python script.py              # Run without activating

═══════════════════════════════════════════════════════════════════════════
  MIGRATION FROM CONDA/MAMBA
═══════════════════════════════════════════════════════════════════════════

  conda create -n myenv python=3.11  →  pixi init myenv && pixi add python=3.11
  conda activate myenv               →  pixi shell
  conda deactivate                   →  exit
  conda install numpy                →  pixi add numpy
  conda remove numpy                 →  pixi remove numpy
  conda env export > env.yml         →  pixi workspace export conda-environment
  conda env create -f env.yml        →  pixi import conda-environment env.yml

═══════════════════════════════════════════════════════════════════════════
  GLOBAL TOOLS (replaces brew/apt for CLI tools)
═══════════════════════════════════════════════════════════════════════════

  pixi global install ripgrep bat fd gh nvim btop
  pixi global list
  pixi global update

═══════════════════════════════════════════════════════════════════════════
  TASK RUNNER (define in pixi.toml)
═══════════════════════════════════════════════════════════════════════════

  pixi task add test pytest tests/
  pixi task add build "python -m build"
  pixi run test                         # Run task
  pixi run build

═══════════════════════════════════════════════════════════════════════════
  MULTI-ENVIRONMENT (dev, test, docs in one project)
═══════════════════════════════════════════════════════════════════════════

  pixi add --feature dev pytest ruff
  pixi add --feature docs sphinx
  pixi shell --environment dev

═══════════════════════════════════════════════════════════════════════════
  ONE-OFF COMMANDS (no project needed)
═══════════════════════════════════════════════════════════════════════════

  pixi exec python -VV                  # Run in temp environment
  pixi exec --spec "python=3.12" python -VV

Docs: https://pixi.sh
      https://pixi.sh/latest/switching_from/conda/
EOF
            __mamba_wrap "$@"
            ;;
        *)
            __mamba_wrap "$@"
            ;;
    esac
}
{{ end }}

