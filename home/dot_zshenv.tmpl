}
{{- end }}
{{- if and (or (eq .profile "work") (and (eq .profile "personal") (or (eq .chezmoi.os "darwin") (eq .chezmoi.os "windows")))) (lookPath "mamba") }}

conda() {
  mamba "$@"
  local ret=$?
  if [[ $ret -ne 0 ]]; then
    cat >&2 << 'EOF'
╔═══════════════════════════════════════════════════════════════════════════╗
