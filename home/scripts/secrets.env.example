# secrets.env — L1 self-bootstrap environment (age-encrypted at rest)
#
# This is the PLAINTEXT template. Encrypt it with age (recipient pinned in
# home/.chezmoi.toml.tmpl) and place next to bootstrap-l1.sh / in the repo root:
#
#   age -e -r age1s5nfmrjdljyh2hz3nary72zm5478dyrrsudgph043hmgs7c8gy4sc3ys0c \
#       -o secrets.env.age secrets.env
#
# L1 decrypts it with its own age identity (~/.config/chezmoi/age-key.txt) and
# exports every line as env for the L2/L3 layers. NEVER commit the plaintext.
#
# Example entries (used by run_onchange_linux-cloud-services.sh.tmpl etc.):
#SUB2API_REPO=https://github.com/your/sub2api.git
#SUB2API_PORT=8317
#CLIPROXY_API_TOKEN=...
#GH_TOKEN=...
