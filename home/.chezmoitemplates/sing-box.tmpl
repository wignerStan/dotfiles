{{- /* Shared sing-box config template, rendered for three platforms.
       The calling (thin) template injects .singbox_platform:
         "macos"   -> desktop instance (host-detected sing-box version)
         "ios"     -> iOS instance (schema declared via singbox_ios_new_schema)
         "android" -> Android instance (singbox_android_new_schema)
     Common guard: only render when server secrets exist.
     independent_cache is gated on the sing-box VERSION only (>= 1.14
     deprecated it), never on the platform. */ -}}
{{- if hasKey . "singbox_server" -}}
{{- /* ---- platform selection ---- */ -}}
{{- $platform := "macos" -}}
{{- if hasKey . "singbox_platform" -}}{{- $platform = .singbox_platform -}}{{- end -}}
{{- $isMacOS := eq $platform "macos" -}}
{{- $isIOS := eq $platform "ios" -}}
{{- $isAndroid := eq $platform "android" -}}
{{- /* ---- schema version + platform data ----
       Desktop: detect the actually-installed sing-box version.
       Mobile: schema version is a declared data flag (set true once the
       device runs sing-box >= 1.14). */ -}}
{{- $singbox_dir := "" -}}
{{- if $isMacOS -}}
{{-   if eq .chezmoi.os "darwin" -}}
{{-     $singbox_dir = "/opt/homebrew/etc/sing-box" -}}
{{-   else -}}
{{-     $singbox_dir = "/etc/sing-box" -}}
{{-   end -}}
{{- end -}}
{{- $newSchema := false -}}
{{- $minVersion := "1.11.0" -}}
{{- if $isMacOS -}}
{{-   $sbVersionLine := "sing-box version 0.0.0" -}}
{{-   if lookPath "sing-box" -}}
{{-     $sbVersionLine = first (splitList "\n" (output "sing-box" "version")) -}}
{{-   end -}}
{{-   $sbParts := split "." (trimPrefix "version " (regexFind "version [0-9]+\\.[0-9]+" $sbVersionLine)) -}}
{{-   $newSchema = ge (atoi $sbParts._1) 14 -}}
{{-   if or (lt (atoi $sbParts._0) 1) (and (eq (atoi $sbParts._0) 1) (lt (atoi $sbParts._1) 11)) -}}
{{-     fail (printf "sing-box %s is too old: config requires %s+ (rule action/DNS action fields)" (trimPrefix "sing-box " $sbVersionLine) $minVersion) -}}
{{-   end -}}
{{- else if $isIOS -}}
{{-   if hasKey . "singbox_ios_new_schema" -}}{{- $newSchema = .singbox_ios_new_schema -}}{{- end -}}
{{- else -}}
{{-   if hasKey . "singbox_android_new_schema" -}}{{- $newSchema = .singbox_android_new_schema -}}{{- end -}}
{{- end -}}
{{- /* ---- per-device uuid ---- */ -}}
{{- $uuid := "" -}}
{{- if $isMacOS -}}
{{-   $uuid = .singbox_uuid -}}
{{- else if $isIOS -}}
{{-   $uuid = .singbox_ios_uuid -}}
{{- else -}}
{{-   $uuid = .singbox_android_uuid -}}
{{- end -}}
{{- /* ---- roxybrowser blocking (macOS only) ---- */ -}}
{{- $roxyBlockMode := "off" -}}
{{- if and $isMacOS (hasKey . "security") (hasKey .security "roxybrowser") (hasKey .security.roxybrowser "block_mode") -}}
{{-   $roxyBlockMode = .security.roxybrowser.block_mode -}}
{{- end -}}
