{{- /* BuildBarn remote cache/execution for personal dev machines.
     The endpoint and worker image are NOT hardcoded here — they live in
     .chezmoidata/secrets.toml (buildbarn_endpoint, buildbarn_worker_image).
     Cross-platform: gated on the `profile` identity axis, so it applies on
     any OS (darwin/linux) where profile == "personal". Windows VM has no
     bazel remote use, so skip there (and secrets.toml may not be present). */ -}}
{{- /* Personal bare-metal dev machines (not VM guests, not Windows). */ -}}
{{- if and (and (eq .profile "personal") (ne .chezmoi.os "windows")) (not .is_vm) -}}
# BuildBarn remote (k3s on the `incus` host, over Tailscale)
# cache only: local execution + remote CAS/action cache (works for any project)
{{- if hasKey . "buildbarn_endpoint" }}
build:remotecache --remote_cache=grpc://{{ .buildbarn_endpoint }}
{{- end }}
# full remote execution on the Linux worker (BuildBarn needs an exact platform match)
build:remote --config=remotecache
{{- if hasKey . "buildbarn_endpoint" }}
build:remote --remote_executor=grpc://{{ .buildbarn_endpoint }}
{{- end }}
build:remote --remote_default_exec_properties=OSFamily=Linux
{{- if hasKey . "buildbarn_worker_image" }}
build:remote --remote_default_exec_properties=container-image=docker://{{ .buildbarn_worker_image }}
{{- end }}
{{- else -}}
# BuildBarn remote config skipped (profile={{ .profile }}, is_vm={{ .is_vm }})
{{- end -}}
