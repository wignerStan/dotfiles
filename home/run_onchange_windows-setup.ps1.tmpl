{{- /* Windows-only: renders empty on macOS/Linux, so chezmoi skips execution there. */ -}}
{{- if eq .chezmoi.os "windows" -}}
#powershell
# ---------------------------------------------------------------
# Jacob's Windows Setup
# Idempotent (safe to re-run via run_onchange). tier={{ .tier }} mode={{ .setup_mode }} geo={{ .geo }}
#
# Install strategy by tier (tier is orthogonal to setup_mode):
#   simple  (VM/container) -> NO package managers. Remove winget/scoop if present.
#                             Direct install: git (MinGit, no Bash/GUI), uv, micromamba.
#                             NO sing-box (rides host proxy).
#   standard/develop       -> winget + scoop (extras bucket). Via PMs: git (full,
#                             Bash+GUI), uv, micromamba, pixi. Plus sing-box core
#                             (direct) + Windows Administrator service (start=auto).
# ---------------------------------------------------------------
# Managed by Chezmoi — runs on Windows only. Do not edit in place.

# NOTE: 'Continue' not 'Stop' — on Windows PowerShell 5.1, native stderr merged via
# 2>&1 becomes ErrorRecords; with 'Stop' that kills pipelines (e.g. uv download
# progress lines). Critical steps use explicit -EA Stop inside try/catch instead.
$ErrorActionPreference = 'Continue'
$ProgressPreference    = 'SilentlyContinue'

function Write-Step($m){ Write-Host "==> $m" -ForegroundColor Cyan }
function Write-Ok($m){    Write-Host "    ok: $m" -ForegroundColor Green }
function Write-Skip($m){  Write-Host "    skip: $m (already present)" -ForegroundColor DarkGray }

function Update-EnvPath {
    $env:Path = [Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [Environment]::GetEnvironmentVariable('Path','User')
}
Update-EnvPath
function Test-Cmd($n) { return [bool](Get-Command $n -ErrorAction SilentlyContinue) }

# Architecture -> asset suffix (ARM64 vs x86_64). Win11 on Parallels = arm64.
$__arch = '64-bit'
if ($env:PROCESSOR_ARCHITECTURE -match 'ARM|aarch64') { $__arch = 'arm64' }

Write-Step "Starting Windows Setup (tier={{ .tier }} mode={{ .setup_mode }} geo={{ .geo }} arch=$__arch)"

# ---------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------

# Download + extract a GitHub release zip into a target dir; add its bin to User PATH.
# For simple-tier direct installs (no package manager).
function Install-Direct {
    param(
        [string]$Label, [string]$Url, [string]$Dest, [string[]]$PathDirs, [string]$TestBin
    )
    if ($TestBin -and (Test-Cmd $TestBin)) { Write-Skip $Label; return }
    Write-Step "$Label — direct install (no package manager)"
    try {
        $zip = Join-Path $env:TEMP "$([guid]::NewGuid().ToString('N')).zip"
        Invoke-WebRequest -Uri $Url -OutFile $zip -UseBasicParsing
        if (Test-Path $Dest) { Remove-Item $Dest -Recurse -Force -EA SilentlyContinue }
        New-Item -ItemType Directory -Force -Path $Dest | Out-Null
        Expand-Archive -Path $zip -DestinationPath $Dest -Force
        Remove-Item $zip -Force
        # add requested subdirs to User PATH
        $up = [Environment]::GetEnvironmentVariable('Path','User')
        foreach ($pd in $PathDirs) {
            $full = Join-Path $Dest $pd
            if ($up -notlike "*$full*") { $up = "$full;$up" }
        }
        [Environment]::SetEnvironmentVariable('Path', $up, 'User')
        Update-EnvPath
        if ($TestBin -and (Test-Cmd $TestBin)) { Write-Ok "$Label direct"; return }
        Write-Host "    $Label installed; restart shell for PATH" -ForegroundColor Yellow
        return
    } catch {
        Write-Host "    $Label direct install FAILED: $($_.Exception.Message)" -ForegroundColor Red
        return $false
    }
}

# winget-first, scoop-fallback (default tier only).
function Install-Tool {
    param([string]$WingetId, [string]$ScoopName, [string]$BinName, [string]$Label)
    if (Test-Cmd $BinName) { Write-Skip $Label; return $true }
    if (Test-Cmd 'winget') {
        Write-Step "$Label — winget install $WingetId"
        & winget install --id $WingetId -e --source winget --accept-source-agreements --accept-package-agreements --disable-interactivity --silent 2>&1 | ForEach-Object { Write-Host "    $_" -ForegroundColor DarkGray }
        Update-EnvPath
        if (Test-Cmd $BinName) { Write-Ok "$Label via winget"; return $true }
    }
    if (Test-Cmd 'scoop') {
        Write-Step "$Label — fallback: scoop install $ScoopName"
        & scoop install $ScoopName 2>&1 | ForEach-Object { Write-Host "    $_" -ForegroundColor DarkGray }
        Update-EnvPath
        if (Test-Cmd $BinName) { Write-Ok "$Label via scoop"; return $true }
    }
    Write-Host "    FAILED to install $Label" -ForegroundColor Red
    return $false
}

# Resolve latest GitHub release tag for a repo (avoids hardcoding versions).
function Get-LatestRelease {
    param([string]$Repo)
    try {
        $r = Invoke-RestMethod -Uri "https://api.github.com/repos/$Repo/releases/latest" -UseBasicParsing -Headers @{ 'User-Agent' = 'chezmoi-bootstrap' }
        return $r.tag_name
    } catch { return $null }
}

# ---------------------------------------------------------------
# shared env (uv mirror)
# ---------------------------------------------------------------
{{- if .use_china_mirrors }}
$env:UV_DEFAULT_INDEX = 'https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple'
[Environment]::SetEnvironmentVariable('UV_DEFAULT_INDEX', 'https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple', 'User')
{{- end }}

# mamba root prefix — only set up when mamba is actually used (non-simple tiers).
# simple tier uses uv-managed python, no mamba at all.
{{- if ne .tier "simple" }}
$mambaRoot = '{{ .mamba_root }}'
[Environment]::SetEnvironmentVariable('MAMBA_ROOT_PREFIX', $mambaRoot, 'User')
$env:MAMBA_ROOT_PREFIX = $mambaRoot
if (-not (Test-Path $mambaRoot)) { New-Item -ItemType Directory -Force -Path $mambaRoot | Out-Null }
{{- end }}

# ---------------------------------------------------------------
# 1. INSTALL STRATEGY
# ---------------------------------------------------------------
{{- if eq .tier "simple" }}
# ── SIMPLE (VM/container): direct installs, remove package managers ──
Write-Step "tier=simple: direct installs (no winget/scoop)"

# remove winget (App Installer Appx) if present — VM doesn't use package managers.
# (We only unregister the Appx; it can be re-added from the Store if ever needed.)
# NOTE: -AllUsers needs elevation; without admin this degrades to a warning.
try {
    $__wingetPkgs = Get-AppxPackage -AllUsers -EA Stop | Where-Object { $_.Name -eq 'Microsoft.DesktopAppInstaller' }
    foreach ($pkg in $__wingetPkgs) {
        try { $pkg | Remove-AppxPackage -AllUsers -EA Stop; Write-Ok "removed winget (App Installer)" }
        catch { Write-Host "    winget removal skipped: $($_.Exception.Message)" -ForegroundColor Yellow }
    }
} catch { Write-Host "    winget removal skipped (needs admin): $($_.Exception.Message)" -ForegroundColor Yellow }
# remove scoop if present
if (Test-Path "$env:USERPROFILE\scoop") {
    Remove-Item "$env:USERPROFILE\scoop" -Recurse -Force -EA SilentlyContinue
    $up = [Environment]::GetEnvironmentVariable('Path','User')
    $up = (($up -split ';') | Where-Object { $_ -and $_ -notmatch 'scoop\\shims' }) -join ';'
    [Environment]::SetEnvironmentVariable('Path', $up, 'User')
    Write-Ok 'removed scoop'
}
Update-EnvPath

# git — MinGit (core only, NO Git Bash, NO Git GUI)
# tag v2.55.0.windows.3 -> asset version 2.55.0.3 (".windows.N" -> ".N")
$gTag = Get-LatestRelease 'git-for-windows/git'
$gv = ($gTag -replace '^v','' -replace '\.windows\.','.')   # v2.55.0.windows.3 -> 2.55.0.3
if ($gv) {
    Install-Direct -Label 'git (MinGit)' `
        -Url "https://github.com/git-for-windows/git/releases/download/$gTag/MinGit-$gv-$__arch.zip" `
        -Dest "$env:USERPROFILE\.local\mingit" -PathDirs @('cmd','mingw64\bin') -TestBin 'git'
}

# uv — direct from Astral (standalone zip)
$uvTag = Get-LatestRelease 'astral-sh/uv'
if ($uvTag) {
    $uvArc = if ($__arch -eq 'arm64') { 'aarch64-pc-windows-msvc' } else { 'x86_64-pc-windows-msvc' }
    Install-Direct -Label 'uv' `
        -Url "https://github.com/astral-sh/uv/releases/download/$uvTag/uv-$uvArc.zip" `
        -Dest "$env:USERPROFILE\.local\uv" -PathDirs @('') -TestBin 'uv'
}

# Python — via uv (system python, no mamba on simple tier).
# uv is installed above; use it to install a managed CPython that uv exposes as
# the system python. Idempotent.
if (Test-Cmd 'uv') {
    Update-EnvPath
    Write-Step "python via uv (uv python install)"
    try {
        {{- if eq .chezmoi.arch "arm64" }}
        # uv defaults to emulated x86_64 python on Windows ARM64; request native aarch64 explicitly.
        & uv python install --no-progress cpython-3.14-windows-aarch64-none 2>&1 | ForEach-Object { Write-Host "    $_" -ForegroundColor DarkGray }
        {{- else }}
        & uv python install --no-progress 2>&1 | ForEach-Object { Write-Host "    $_" -ForegroundColor DarkGray }
        {{- end }}
        # expose uv's managed python dir so plain `python`/`pip` resolve
        {{- if eq .chezmoi.arch "arm64" }}
        $pyRoot = & uv python dir cpython-3.14-windows-aarch64-none 2>$null
        {{- else }}
        $pyRoot = & uv python dir 2>$null
        {{- end }}
        if ($pyRoot -and (Test-Path $pyRoot)) {
            $up = [Environment]::GetEnvironmentVariable('Path','User')
            if ($up -notlike "*$pyRoot*") { [Environment]::SetEnvironmentVariable('Path', "$pyRoot;$up", 'User') }
        }
        Write-Ok 'python via uv'
    } catch { Write-Host "    uv python install warning: $($_.Exception.Message)" -ForegroundColor Yellow }
}

# 7zip — direct installer from ip7z/7zip GitHub releases (official 7-zip mirror).
# Native arch build (arm64 on ARM machines, x64 otherwise). Silent per-user
# install into LOCALAPPDATA (no UAC); falls back to default Program Files.
$__7zArc = if ($__arch -eq 'arm64') { 'arm64' } else { 'x64' }
if (Test-Cmd '7z') { Write-Skip '7zip' }
else {
    $__7zTag = Get-LatestRelease 'ip7z/7zip'
    if ($__7zTag) {
        $__7zVer = ($__7zTag -replace '\.','')   # 26.02 -> 2602
        $__7zInst = Join-Path $env:TEMP "7z$__7zVer-$__7zArc.exe"
        Write-Step "7zip — direct installer (no package manager, $__7zArc)"
        try {
            Invoke-WebRequest -Uri "https://github.com/ip7z/7zip/releases/download/$__7zTag/7z$__7zVer-$__7zArc.exe" -OutFile $__7zInst -UseBasicParsing
            $__7zDest = "$env:LOCALAPPDATA\7-Zip"
            Start-Process -Wait -FilePath $__7zInst -ArgumentList '/S', "/D=$__7zDest"
            if (-not (Test-Path "$__7zDest\7z.exe")) {
                # per-user install didn't land — try default dir (needs elevation)
                Start-Process -Wait -FilePath $__7zInst -ArgumentList '/S'
                $__7zDest = Join-Path ${env:ProgramFiles} '7-Zip'
            }
            Remove-Item $__7zInst -Force -EA SilentlyContinue
            if (Test-Path "$__7zDest\7z.exe") {
                $up = [Environment]::GetEnvironmentVariable('Path','User')
                if ($up -notlike "*$__7zDest*") { [Environment]::SetEnvironmentVariable('Path', "$__7zDest;$up", 'User') }
                Update-EnvPath
                Write-Ok '7zip'
            } else { Write-Host "    7zip: installer ran but no 7z.exe found" -ForegroundColor Yellow }
        } catch { Write-Host "    7zip install failed: $($_.Exception.Message)" -ForegroundColor Yellow }
    }
}

# Geek Uninstaller — portable zip, direct from official site (no package manager).
if (Test-Cmd 'geek') { Write-Skip 'Geek Uninstaller' }
else {
    Write-Step "Geek Uninstaller — portable zip (no package manager)"
    try {
        $__gkZip = Join-Path $env:TEMP "geek.zip"
        Invoke-WebRequest -Uri 'https://geekuninstaller.com/geek.zip' -OutFile $__gkZip -UseBasicParsing
        $__gkDest = "$env:LOCALAPPDATA\GeekUninstaller"
        New-Item -ItemType Directory -Force -Path $__gkDest | Out-Null
        Expand-Archive -Path $__gkZip -DestinationPath $__gkDest -Force
        Remove-Item $__gkZip -Force
        if (Test-Path "$__gkDest\geek*.exe") {
            $up = [Environment]::GetEnvironmentVariable('Path','User')
            if ($up -notlike "*$__gkDest*") { [Environment]::SetEnvironmentVariable('Path', "$__gkDest;$up", 'User') }
            Update-EnvPath
            Write-Ok 'Geek Uninstaller'
        } else { Write-Host "    GeekUninstaller: zip extracted but no exe found" -ForegroundColor Yellow }
    } catch { Write-Host "    Geek Uninstaller install failed: $($_.Exception.Message)" -ForegroundColor Yellow }
}

{{- else }}
# ── STANDARD/DEVELOP: winget + scoop, install via package managers ──
Write-Step "tier={{ .tier }}: package managers (winget + scoop)"

# winget (App Installer) — ensure callable
if (Test-Cmd 'winget') { Write-Skip 'winget' }
else {
    Write-Step "winget missing — opening Store for 'App Installer'"
    try { Start-Process 'ms-windows-store:' -EA SilentlyContinue } catch {}
}

# scoop + extras bucket
if (Test-Cmd 'scoop') { Write-Skip 'scoop' }
else {
    Write-Step "Installing scoop + extras bucket..."
    try {
        Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser -EA SilentlyContinue
        Invoke-RestMethod -Uri https://get.scoop.sh | Invoke-Expression
        Update-EnvPath
        & scoop bucket add extras 2>&1 | Out-Null
        if (Test-Cmd 'scoop') { Write-Ok 'scoop + extras' } else { Write-Host "    scoop not on PATH (restart shell)" -ForegroundColor Yellow }
    } catch { Write-Host "    scoop install failed: $($_.Exception.Message)" -ForegroundColor Yellow }
}

# Tools via winget (scoop fallback): git (full, with Git Bash + GUI), uv, micromamba, pixi.
# (sing-box core is installed directly in both tiers — see below — since its winget
# package is unreliable and the core binary has clean GitHub releases.)
Install-Tool -WingetId 'Git.Git'              -ScoopName 'git'        -BinName 'git'        -Label 'git (full)'
Install-Tool -WingetId 'astral-sh.uv'          -ScoopName 'uv'         -BinName 'uv'         -Label 'uv'
Install-Tool -WingetId 'Mamba.Micromamba'      -ScoopName 'micromamba' -BinName 'micromamba' -Label 'micromamba'
Install-Tool -WingetId 'prefix-dev.pixi'       -ScoopName 'pixi'       -BinName 'pixi'       -Label 'pixi'

# Basic CLI/shell/dev tools — mirror of the unix brew basic, via winget (scoop fallback).
Install-Tool -WingetId 'Starship.Starship'       -ScoopName 'starship'  -BinName 'starship'  -Label 'starship'
Install-Tool -WingetId 'ajeetdsouza.zoxide'      -ScoopName 'zoxide'    -BinName 'zoxide'    -Label 'zoxide'
Install-Tool -WingetId 'eza-community.eza'       -ScoopName 'eza'       -BinName 'eza'       -Label 'eza'
Install-Tool -WingetId 'sharkdp.bat'             -ScoopName 'bat'       -BinName 'bat'       -Label 'bat'
Install-Tool -WingetId 'BurntSushi.ripgrep'      -ScoopName 'ripgrep'   -BinName 'rg'        -Label 'ripgrep'
Install-Tool -WingetId 'sharkdp.fd'              -ScoopName 'fd'        -BinName 'fd'        -Label 'fd'
Install-Tool -WingetId 'junegunn.fzf'            -ScoopName 'fzf'       -BinName 'fzf'       -Label 'fzf'
Install-Tool -WingetId 'jqlang.jq'               -ScoopName 'jq'        -BinName 'jq'        -Label 'jq'
Install-Tool -WingetId 'MikeFarah.yq'            -ScoopName 'yq'        -BinName 'yq'        -Label 'yq'
Install-Tool -WingetId 'GitHub.cli'              -ScoopName 'gh'        -BinName 'gh'        -Label 'gh'
Install-Tool -WingetId 'GLab.GLab'               -ScoopName 'glab'      -BinName 'glab'      -Label 'glab'
Install-Tool -WingetId 'FiloSottile.age'         -ScoopName 'age'       -BinName 'age'       -Label 'age'
Install-Tool -WingetId 'Fastfetch-cli.Fastfetch' -ScoopName 'fastfetch' -BinName 'fastfetch' -Label 'fastfetch'
Install-Tool -WingetId '7zip.7zip'               -ScoopName '7zip'      -BinName '7z'        -Label '7zip'
Install-Tool -WingetId 'astral-sh.ruff'          -ScoopName 'ruff'      -BinName 'ruff'      -Label 'ruff'
Install-Tool -WingetId 'JohnnyMorganz.StyLua'    -ScoopName 'stylua'    -BinName 'stylua'    -Label 'stylua'
Install-Tool -WingetId 'Nushell.Nushell'         -ScoopName 'nushell'   -BinName 'nu'        -Label 'nushell'
# Frontend/UI/package stack (basic). rust/go/C++ toolchains stay in WSL, NOT native windows.
Install-Tool -WingetId 'OpenJS.NodeJS'           -ScoopName 'nodejs'    -BinName 'node'      -Label 'Node.js'
Install-Tool -WingetId 'pnpm.pnpm'               -ScoopName 'pnpm'      -BinName 'pnpm'      -Label 'pnpm'
Install-Tool -WingetId 'Oven-sh.Bun'             -ScoopName 'bun'       -BinName 'bun'       -Label 'Bun'

# Coreutils via winget (Microsoft.Coreutils) + scoop unix/text utils (basic windows).
# NOTE: perl is NOT installed here. Git Bash (Git.Git, full install) already embeds perl —
#       do NOT add StrawberryPerl (StrawberryPerl.StrawberryPerl); rely on Git Bash's perl.
if (Test-Cmd 'winget') {
    Write-Step "Microsoft.Coreutils — winget install"
    & winget install --id Microsoft.Coreutils -e --source winget --accept-source-agreements --accept-package-agreements --disable-interactivity --silent 2>&1 | ForEach-Object { Write-Host "    $_" -ForegroundColor DarkGray }
    Update-EnvPath
}
if (Test-Cmd 'scoop') {
    & scoop install cacert lessmsi innounp 2>&1 | ForEach-Object { Write-Host "    $_" -ForegroundColor DarkGray }
    & scoop install gawk sed file scoop-search 2>&1 | ForEach-Object { Write-Host "    $_" -ForegroundColor DarkGray }
    Update-EnvPath
}
{{- end }}

# ---------------------------------------------------------------
# Level 2: Extra (setup_mode=full, non-simple) — desktop dev/media tools.
# Mirrors the Unix bootstrap's Level 2: terminal emulator + downloaders.
# ---------------------------------------------------------------
{{- if and (eq .setup_mode "full") (ne .tier "simple") }}
Write-Step "Level 2: extra tools (setup_mode=full)"

# Terminal emulator. WezTerm is the windows terminal (ghostty/iterm2 on mac).
Install-Tool -WingetId 'wez.wezterm' -ScoopName 'wezterm' -BinName 'wezterm' -Label 'WezTerm'

# TeX — windows uses MiKTeX (mac: BasicTeX, linux: texlive).
Install-Tool -WingetId 'MiKTeX.MiKTeX' -ScoopName 'miktex' -BinName 'miktex' -Label 'MiKTeX'

# Uninstaller utility (desktop).
Install-Tool -WingetId 'GeekUninstaller.GeekUninstaller' -ScoopName 'geek' -BinName 'geek' -Label 'Geek Uninstaller'

# Cross-platform CLI tools (mirror Unix Level 2)
Install-Tool -WingetId 'Rclone.Rclone'           -ScoopName 'rclone'    -BinName 'rclone'    -Label 'rclone'
Install-Tool -WingetId 'ngrok.ngrok'              -ScoopName 'ngrok'     -BinName 'ngrok'     -Label 'ngrok'
Install-Tool -WingetId 'Syncthing.Syncthing'     -ScoopName 'syncthing' -BinName 'syncthing' -Label 'syncthing'
Install-Tool -WingetId 'Cloudflare.cloudflared'  -ScoopName 'cloudflared' -BinName 'cloudflared' -Label 'cloudflared'

# Desktop apps (mac+win personal casks, winget equivalents)
{{- if and (eq .profile "personal") (not .is_headless) }}
Write-Step "Personal desktop apps (winget)"
$__desktopApps = @(
    @{Id='Obsidian.Obsidian';          Label='Obsidian'},
    @{Id='SiYuan.SiYuan';              Label='SiYuan'},
    @{Id='LocalSend.LocalSend';        Label='LocalSend'},
    @{Id='KeePassXCTeam.KeePassXC';    Label='KeePassXC'},
    @{Id='Zoom.Zoom';                  Label='Zoom'},
    @{Id='Microsoft.RemoteDesktop';    Label='Windows App (RDP)'},
    @{Id='Google.PlatformTools';       Label='Android Platform Tools (adb)'}
)
foreach ($app in $__desktopApps) {
    if (Test-Cmd 'winget') {
        & winget install --id $app.Id -e --source winget --accept-source-agreements --accept-package-agreements --disable-interactivity --silent 2>&1 | ForEach-Object { Write-Host "    $_" -ForegroundColor DarkGray }
    }
}
{{- end }}

{{- if and (eq .profile "personal") (not .is_headless) }}
# Downloaders — windows personal desktop only (brew can't pull these reliably).
Install-Tool -WingetId 'yt-dlp.yt-dlp' -ScoopName 'yt-dlp' -BinName 'yt-dlp' -Label 'yt-dlp'

# bilidown — direct install (no winget/scoop package): iuroc/bilidown GoReleaser zip.
$__bdTag = Get-LatestRelease 'iuroc/bilidown'
if ($__bdTag) {
    $__bdArc = if ($__arch -eq 'arm64') { 'arm64' } else { 'x86_64' }
    Install-Direct -Label 'bilidown (Bilibili downloader)' `
        -Url "https://github.com/iuroc/bilidown/releases/download/$__bdTag/bilidown_Windows_$__bdArc.zip" `
        -Dest "$env:USERPROFILE\.local\bilidown" -PathDirs @('') -TestBin 'bilidown'
}
{{- end }}
{{- end }}

# ---------------------------------------------------------------
# Level 3: Develop (windows) — WSL only. Heavy toolchains (rust/go/C++) live in
# the personal WSL (linux), NOT native windows; native gets only the basic
# frontend/UI/package tools installed above. WSL internals are personal/separate.
# ---------------------------------------------------------------
{{- if eq .tier "develop" }}
Write-Step "develop: enable WSL (rust/go/C++ toolchains live in the personal WSL)"
try {
    & wsl --install --no-distribution 2>&1 | ForEach-Object { Write-Host "    $_" -ForegroundColor DarkGray }
    Write-Ok 'wsl --install (reboot to finalize if newly enabled)'
} catch { Write-Host "    wsl setup needs Administrator: $($_.Exception.Message)" -ForegroundColor Yellow }
{{- end }}

# ---------------------------------------------------------------
# sing-box CORE + Windows Administrator service — personal mac/windows ONLY
# (standard/develop tiers). sing-box installs when profile=personal AND tier is
# NOT simple. The core binary (SagerNet/sing-box) is downloaded directly (not a
# GUI app; winget id unreliable), and registered as a Windows Service (start=auto,
# runs as LocalSystem == Admin) so the TUN proxy is up at boot. Linux personal uses
# the "system" tier instead (no sing-box); simple tier (VM/container) rides the host.
# ---------------------------------------------------------------
{{- if and (eq .profile "personal") (not (eq .tier "simple")) }}
$sbTag = Get-LatestRelease 'SagerNet/sing-box'
if ($sbTag) {
    $sbVer = $sbTag -replace '^v',''   # v1.13.16 -> 1.13.16
    $sbOk = Install-Direct -Label 'sing-box (core)' `
        -Url "https://github.com/SagerNet/sing-box/releases/download/$sbTag/sing-box-$sbVer-windows-$__arch.zip" `
        -Dest "$env:USERPROFILE\.local\sing-box" -PathDirs @('') -TestBin 'sing-box'

    # Register the Windows service (admin). Idempotent: recreate so binPath stays
    # current. Config path matches the deployed sing-box config.
    $sbExe = "$env:USERPROFILE\.local\sing-box\sing-box.exe"
    $sbCfg = "$env:USERPROFILE\.config\sing-box\config.json"
    if ($sbOk -and (Test-Path $sbExe) -and (Test-Path $sbCfg)) {
        Write-Step "sing-box service (LocalSystem, start=auto)"
        try {
            & sc.exe stop sing-box 2>&1 | Out-Null
            & sc.exe delete sing-box 2>&1 | Out-Null
            Start-Sleep -Seconds 1
            $binPath = "`"$sbExe`" run -c `"$sbCfg`""
            & sc.exe create sing-box binPath= $binPath start= auto DisplayName= "sing-box" 2>&1 | ForEach-Object { Write-Host "    $_" -ForegroundColor DarkGray }
            & sc.exe description sing-box "sing-box TUN proxy (managed by chezmoi)" 2>&1 | Out-Null
            & sc.exe start sing-box 2>&1 | ForEach-Object { Write-Host "    $_" -ForegroundColor DarkGray }
            Write-Ok 'sing-box service registered + started'
        } catch {
            Write-Host "    sing-box service warning: $($_.Exception.Message)" -ForegroundColor Yellow
            Write-Host "    (service install needs Administrator; re-run elevated)" -ForegroundColor Yellow
        }
    } elseif ($sbOk -and -not (Test-Path $sbCfg)) {
        Write-Host "    sing-box config not found at $sbCfg - service skipped (place config first)" -ForegroundColor Yellow
    }
}
{{- else }}
Write-Skip 'sing-box (not personal, or simple — rides host proxy)'
{{- end }}

# ---------------------------------------------------------------
# 2. MAMBA BASE ENV (python) — both tiers
# ---------------------------------------------------------------
if (Test-Cmd 'micromamba') {
    Update-EnvPath
    try {
        & micromamba shell init -s powershell -r $mambaRoot 2>&1 | Out-Null
        # base == root prefix (MAMBA_ROOT_PREFIX set); install python INTO root with -r
        if (-not (Test-Path "$mambaRoot\python.exe")) {
            Write-Step "Installing python into mamba base (root prefix)"
            & micromamba install -y -c conda-forge python -r $mambaRoot 2>&1 |
                ForEach-Object { Write-Host "    $_" -ForegroundColor DarkGray }
        }
        Write-Ok 'micromamba base env ready'
    } catch {
        Write-Host "    micromamba env init warning: $($_.Exception.Message)" -ForegroundColor Yellow
    }
}

# ---------------------------------------------------------------
# 3. pywinauto (GUI automation, Windows-only)
#    Installed when: tier is simple OR develop, OR profile is work.
#    default tier (personal desktop) skips it.
#    Python source: simple -> uv (no mamba); develop/work -> mamba base.
# ---------------------------------------------------------------
{{- if or (or (eq .tier "simple") (eq .tier "develop")) (eq .profile "work") }}
{{- if eq .tier "simple" }}
# simple: uv is the python — install pywinauto into uv's managed python.
# On ARM64, resolve the native aarch64 python explicitly (uv's default is the
# emulated x86_64 build) instead of relying on `uv run`'s default selection.
if (Test-Cmd 'uv') {
    try {
        Update-EnvPath
        {{- if eq .chezmoi.arch "arm64" }}
        $__pyExe = & uv python find cpython-3.14-windows-aarch64-none 2>$null
        {{- else }}
        $__pyExe = & uv python find 2>$null
        {{- end }}
        if (-not $__pyExe) { throw "uv python not found" }
        $have = & $__pyExe -c "import pywinauto" 2>$null
        if ($LASTEXITCODE -eq 0) { Write-Skip 'pywinauto' }
        else {
            Write-Step "Installing pywinauto (uv python)"
            {{- if .use_china_mirrors }}
            & uv pip install --python "$__pyExe" --break-system-packages -i https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple pywinauto 2>&1 | ForEach-Object { Write-Host "    $_" -ForegroundColor DarkGray }
            {{- else }}
            & uv pip install --python "$__pyExe" --break-system-packages pywinauto 2>&1 | ForEach-Object { Write-Host "    $_" -ForegroundColor DarkGray }
            {{- end }}
            Write-Ok 'pywinauto installed (uv python)'
        }
    } catch { Write-Host "    pywinauto warning: $($_.Exception.Message)" -ForegroundColor Yellow }
}
{{- else }}
# develop/work: mamba base python.
if ((Test-Cmd 'micromamba') -and (Test-Path "$mambaRoot\python.exe")) {
    try {
        $have = & micromamba run -n base python -c "import pywinauto" 2>$null
        if ($LASTEXITCODE -eq 0) { Write-Skip 'pywinauto' }
        else {
            Write-Step "Installing pywinauto into mamba base python"
            {{- if .use_china_mirrors }}
            & micromamba run -n base python -m pip install -i https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple pywinauto 2>&1 | ForEach-Object { Write-Host "    $_" -ForegroundColor DarkGray }
            {{- else }}
            & micromamba run -n base python -m pip install pywinauto 2>&1 | ForEach-Object { Write-Host "    $_" -ForegroundColor DarkGray }
            {{- end }}
            Write-Ok 'pywinauto installed (mamba base)'
        }
    } catch { Write-Host "    pywinauto warning: $($_.Exception.Message)" -ForegroundColor Yellow }
}
{{- end }}
{{- else }}
Write-Skip 'pywinauto (tier={{ .tier }} profile={{ .profile }})'
{{- end }}

Write-Step "Windows Setup Complete"
Write-Host "    Restart PowerShell to pick up new PATH entries." -ForegroundColor Yellow

# ---------------------------------------------------------------
# 4. Win11Debloat — unattended cleanup/tweaks (Raphire/Win11Debloat, from GitHub)
#    simple -> RunDefaults (remove bloatware) + aggressive privacy/AI-off
#    other  -> RunDefaultsLite (tweaks only, keep apps)
#    NOTE: needs the FULL repo (Config/Scripts/Regfiles dirs are referenced via
#    $PSScriptRoot); fetching the bare .ps1 breaks with empty-path errors.
# ---------------------------------------------------------------
Write-Step "Win11Debloat (tier={{ .tier }})"
try {
    $debloatFlags = @{
        Silent = $true; CreateRestorePoint = $true
        DisableTelemetry = $true; DisableSuggestions = $true; DisableBing = $true; DisableEdgeAds = $true
        DisableLockscreenTips = $true; RevertContextMenu = $true; ShowKnownFileExt = $true
        ShowHiddenFolders = $true; EnableDarkMode = $true
    {{- if eq .tier "simple" }}
        RunDefaults = $true; AppRemovalTarget = 'AllUsers'; DisableCopilot = $true; DisableWidgets = $true
        DisableRecall = $true; DisableClickToDo = $true; DisableStoreSearchSuggestions = $true; DisableDesktopSpotlight = $true
    {{- else }}
        RunDefaultsLite = $true
    {{- end }}
    }
    $__dRoot = Join-Path $env:USERPROFILE '.local\win11debloat'
    $__dScript = Join-Path $__dRoot 'Win11Debloat.ps1'
    if (-not (Test-Path $__dScript)) {
        Write-Step "Win11Debloat — downloading full repo (Config/Scripts/Regfiles)"
        $__dZip = Join-Path $env:TEMP 'win11debloat.zip'
        Invoke-WebRequest -Uri 'https://github.com/Raphire/Win11Debloat/archive/refs/heads/master.zip' -OutFile $__dZip -UseBasicParsing
        if (Test-Path $__dRoot) { Remove-Item $__dRoot -Recurse -Force -EA SilentlyContinue }
        New-Item -ItemType Directory -Force -Path $__dRoot | Out-Null
        Expand-Archive -Path $__dZip -DestinationPath $__dRoot -Force
        Remove-Item $__dZip -Force
        # zip extracts to Win11Debloat-master/ — flatten one level
        $__dNested = Join-Path $__dRoot 'Win11Debloat-master'
        if (Test-Path $__dNested) {
            Get-ChildItem -Path $__dNested | Move-Item -Destination $__dRoot -Force
            Remove-Item $__dNested -Force -EA SilentlyContinue
        }
    }
    if (Test-Path $__dScript) {
        & $__dScript @debloatFlags 2>&1 | ForEach-Object { Write-Host "    $_" -ForegroundColor DarkGray }
        Write-Ok 'Win11Debloat applied'
    } else {
        Write-Host "    Win11Debloat repo not found at $__dScript" -ForegroundColor Yellow
    }
} catch { Write-Host "    Win11Debloat warning: $($_.Exception.Message)" -ForegroundColor Yellow }
{{- end -}}
