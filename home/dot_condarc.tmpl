channels:
  - https://mirrors.ustc.edu.cn/anaconda/cloud/conda-forge
  - https://mirrors.ustc.edu.cn/anaconda/pkgs/main
  - https://mirrors.ustc.edu.cn/anaconda/pkgs/r
  - conda-forge
use_uv: true
# auto_activate_base: true for work (no brew privileges) and personal desktop
# (macOS/Windows), false for develop (uses brew python as base instead)
{{- if or (eq .profile "work") (and (eq .profile "personal") (or (eq .chezmoi.os "darwin") (eq .chezmoi.os "windows"))) }}
auto_activate_base: true
{{- else }}
auto_activate_base: false
{{- end }}
always_yes: true
changeps1: false
