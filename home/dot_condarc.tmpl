# .condarc — managed by chezmoi (all profiles)
# conda-forge.org is ALWAYS first: it's the only source that serves sharded
# repodata (repodata_shards.msgpack.zst), which makes the solve ~650x smaller/
# faster (424KB vs 274MB flat). No CN mirror (EDU or commercial: USTC/TUNA/Aliyun/
# HuaweiCloud/volces) serves shards, so putting them first forces the slow flat
# fallback and stalls the solve.
channels:
  - conda-forge
{{- if .use_china_mirrors }}
  # CN fallback (geo=cn): faster package downloads from within China if
  # conda-forge.org is slow; never used for the solve since conda-forge is first.
  - https://mirrors.ustc.edu.cn/anaconda/cloud/conda-forge
{{- end }}
use_uv: true
always_yes: true
changeps1: false
# auto_activate_base: false for dev facet (activates 'develop' env instead).
# true for personal/work (base is the Python provider).
{{- if has "dev" .facets }}auto_activate_base: false
{{- else }}auto_activate_base: true
{{- end }}
{{- /* Resolved per-user machine profile; empty means user-local caches. */ -}}
{{- $shared := "" -}}
{{- if hasKey . "shared_workspace" }}{{- $shared = .shared_workspace | default "" }}{{- end -}}
{{- if $shared }}
{{- $cache := "" -}}
{{- if hasKey . "shared_cache" }}{{- $cache = .shared_cache | default "" -}}{{- end -}}
# ── Package cache: account cache on {{ if $cache }}{{ $cache }}{{ else }}{{ $shared }}/mamba{{ end }}, fallback to user cache ──
pkgs_dirs:
  - {{ if $cache }}{{ $cache }}/mamba{{ else }}{{ $shared }}/mamba/pkgs{{ end }}
{{- if eq .chezmoi.username "jacob" }}
  - ~/.cache/conda/pkgs
{{- else if eq .chezmoi.username "dev" }}
  - {{ if $cache }}{{ $cache }}/conda{{ else }}~/.cache/conda/pkgs{{ end }}
{{- end }}
# ── Environments: shared base on {{ $shared }}/mamba, user-specific fallback ──
envs_dirs:
  - {{ $shared }}/mamba/envs
{{- if has "dev" .facets }}
  - ~/.conda/envs
{{- end }}
{{- end }}
