{{- /* Unix bootstrap (Homebrew). Windows: run_onchange_windows-bootstrap.ps1.
     Runs on Unix except local+simple minimal targets; guest role is separate.
     Deploy axis (user|system|system+user), enforced at runtime by identity:
       1) root/system user → ONLY the system scope runs (deploy=system or
          system+user); the user scope is handled by bootstrap-l1.sh after
          dropping privileges to the default uid (1000 linux / 501 darwin).
       2) plain user, deploy=user (default) → user scope only.
       3) plain user, deploy=system → system scope via sudo elevation.
       4) plain user, deploy=system+user → user scope then sudo system scope.
     System commands are ALWAYS elevated ($SUDO) — native/plain-user hosts
     need the password prompt; on root they run directly.
     Cloud (platform=cloud) boxes: distro packages are the system scope here;
     ordered services (nginx/kopia/…) live in run_onchange_linux-cloud-services.sh.tmpl.
     work ownership = STUB gate (kept minimal until a real work machine exists). */ -}}
{{- $axesValidated := includeTemplate "validate-axes" . -}}
{{- if and (ne .chezmoi.os "windows") (or (ne .tier "simple") (eq .platform "cloud")) -}}
#!/bin/bash

# ═══════════════════════════════════════════════════════════════
# Jacob's Multi-Machine Bootstrap (axes v2)
# ownership={{ .ownership }} platform={{ .platform }} tier={{ .tier }}
# facets={{ .facets | join " " }} bootstrap={{ .bootstrap }} deploy={{ .deploy }}
# ═══════════════════════════════════════════════════════════════

set -euo pipefail
echo "=== Dotfiles bootstrap: {{ .ownership }}/{{ .platform }}/{{ .tier }} facets=[{{ .facets | join " " }}] bootstrap={{ .bootstrap }} deploy={{ .deploy }} ==="

# ───────────────────────────────────────────────────────────────
# DEPLOY MATRIX — user (default) | system | system+user
#   1) root/system        → system scope only (system, system+user)
#   2) plain user+user    → user scope only
#   3) plain user+system  → elevated system scope only
#   4) plain user+system+user → user scope then elevated system scope
# ───────────────────────────────────────────────────────────────
DEPLOY="{{ .deploy }}"
RUN_SYSTEM=0
RUN_USER=0
case "${DEPLOY}" in
    system)      RUN_SYSTEM=1 ;;
    user)        RUN_USER=1 ;;
    system+user) RUN_SYSTEM=1; RUN_USER=1 ;;
    *) echo "invalid deploy '${DEPLOY}'" >&2; exit 2 ;;
esac

# System ops are ALWAYS elevated when not root (native/plain-user safe:
# sudo prompts for the password instead of failing on permission errors).
SUDO=""
[[ "$(id -u)" -ne 0 ]] && SUDO="sudo"

# ───────────────────────────────────────────────────────────────
# SYSTEM SCOPE — elevated (system packages, root git config, users)
# ───────────────────────────────────────────────────────────────
system_scope() {
    echo "=== system-scope pass (elevated) ==="
    if command -v apk &>/dev/null; then
        __l2_pkgs=({{- if ne .tier "simple" }}{{- range .packages.system.apk.l2 }} {{ . }}{{- end }}{{- end }})
        __l3_pkgs=({{- if eq .bootstrap "full" }}{{- range .packages.system.apk.l3 }} {{ . }}{{- end }}{{- end }})
        __facet_pkgs=()
{{- if has "dev" .facets }}
        __facet_pkgs+=({{- range .packages.facets.dev.apk }} {{ . }}{{- end }})
{{- end }}
{{- if has "proxy" .facets }}
        __facet_pkgs+=({{- range .packages.facets.proxy.apk }} {{ . }}{{- end }})
{{- end }}
{{- if has "ai" .facets }}
        __facet_pkgs+=({{- range .packages.facets.ai.apk }} {{ . }}{{- end }})
{{- end }}
{{- if has "research" .facets }}
        __facet_pkgs+=({{- range .packages.facets.research.apk }} {{ . }}{{- end }})
{{- end }}
{{- if has "trade" .facets }}
        __facet_pkgs+=({{- range .packages.facets.trade.apk }} {{ . }}{{- end }})
{{- end }}
{{- if has "hpc" .facets }}
        __facet_pkgs+=({{- range .packages.facets.hpc.apk }} {{ . }}{{- end }})
{{- end }}
        if (( ${#__l2_pkgs[@]} > 0 )); then
            $SUDO apk add --no-cache "${__l2_pkgs[@]}" 2>/dev/null \
                || echo "Warning: L2 apk package installation failed"
        fi
        for __pkg in "${__l3_pkgs[@]}" "${__facet_pkgs[@]}"; do
            [[ -n "$__pkg" ]] || continue
            $SUDO apk add --no-cache "$__pkg" 2>/dev/null \
                || echo "Warning: optional apk package failed: $__pkg"
        done
    elif command -v apt-get &>/dev/null; then
        __l2_pkgs=({{- if ne .tier "simple" }}{{- range .packages.system.apt.l2 }} {{ . }}{{- end }}{{- end }})
        __l3_pkgs=({{- if eq .bootstrap "full" }}{{- range .packages.system.apt.l3 }} {{ . }}{{- end }}{{- end }})
        __facet_pkgs=()
{{- if has "dev" .facets }}
        __facet_pkgs+=({{- range .packages.facets.dev.apt }} {{ . }}{{- end }})
{{- end }}
{{- if has "proxy" .facets }}
        __facet_pkgs+=({{- range .packages.facets.proxy.apt }} {{ . }}{{- end }})
{{- end }}
{{- if has "ai" .facets }}
        __facet_pkgs+=({{- range .packages.facets.ai.apt }} {{ . }}{{- end }})
{{- end }}
{{- if has "research" .facets }}
        __facet_pkgs+=({{- range .packages.facets.research.apt }} {{ . }}{{- end }})
{{- end }}
{{- if has "trade" .facets }}
        __facet_pkgs+=({{- range .packages.facets.trade.apt }} {{ . }}{{- end }})
{{- end }}
{{- if has "hpc" .facets }}
        __facet_pkgs+=({{- range .packages.facets.hpc.apt }} {{ . }}{{- end }})
{{- end }}
        if (( ${#__l2_pkgs[@]} + ${#__l3_pkgs[@]} + ${#__facet_pkgs[@]} > 0 )); then
            $SUDO apt-get update -qq
        fi
        if (( ${#__l2_pkgs[@]} > 0 )); then
            echo "  installing L2 system packages: ${__l2_pkgs[*]}"
            $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y "${__l2_pkgs[@]}" 2>/dev/null \
                || echo "Warning: L2 apt package installation failed"
        fi
        for __pkg in "${__l3_pkgs[@]}" "${__facet_pkgs[@]}"; do
            [[ -n "$__pkg" ]] || continue
            $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y "$__pkg" 2>/dev/null \
                || echo "Warning: optional apt package failed: $__pkg"
        done
    fi

    if ! $SUDO git config --global user.name &>/dev/null; then
        $SUDO git config --global user.name "{{ .name }}"
        $SUDO git config --global user.email "{{ .email }}"
        $SUDO git config --global init.defaultBranch main
        $SUDO git config --global pull.rebase true
        echo "Git configured (system scope)"
    fi

    # Auto-create dev/cal users (personal Linux) — system op
{{ if and (eq .chezmoi.os "linux") (eq .ownership "personal") -}}
    # dev user's home is the resolved shared workspace, when this user profile owns one.
{{ $shared := "" -}}
{{- if hasKey . "shared_workspace" }}{{- $shared = .shared_workspace | default "" }}{{- end -}}
{{ $shared_cache := "" -}}
{{- if hasKey . "shared_cache" }}{{- $shared_cache = .shared_cache | default "" }}{{- end -}}
    # shellcheck disable=SC2043  # template may render one or two fixed users
    for u in dev{{ if has "hpc" .facets }} cal{{ end }}; do
        if ! id -u "$u" &>/dev/null; then
            echo "Creating user: $u"
            home_dir="/home/$u"{{ if $shared }}
            [ "$u" = "dev" ] && home_dir="{{ $shared }}"{{ end }}
            $SUDO useradd -m -d "$home_dir" -s /home/linuxbrew/.linuxbrew/bin/bash "$u" 2>/dev/null || echo "Warning: failed to create $u"
            $SUDO usermod -aG dev "$u" 2>/dev/null || true
        fi
        $SUDO chsh -s /home/linuxbrew/.linuxbrew/bin/bash "$u" 2>/dev/null || true
    done
{{- if $shared }}
    # Shared caches/workspaces require both the default user and dev to retain
    # group write access as tools create nested directories. Default ACLs make
    # this durable instead of relying on each tool's umask.
    if id -u dev &>/dev/null; then
        if ! getent group dev >/dev/null 2>&1; then
            $SUDO groupadd dev
        fi
        $SUDO usermod -aG dev dev 2>/dev/null || true
        __default_user="$(id -nu "{{ .default_uid }}" 2>/dev/null || true)"
        if [[ -n "$__default_user" && "$__default_user" != "dev" ]]; then
            $SUDO usermod -aG dev "$__default_user" 2>/dev/null || true
        fi
        for __shared_dir in \
            "{{ $shared }}" \
            "{{ $shared }}/mamba" \
            "{{ $shared }}/mamba/pkgs" \
            "{{ $shared }}/mamba/envs"; do
            $SUDO install -d -o dev -g dev -m 2770 "$__shared_dir"
            if command -v setfacl >/dev/null 2>&1; then
                $SUDO setfacl -m g:dev:rwx,m:rwx "$__shared_dir"
                $SUDO setfacl -d -m u::rwx,g::rwx,o::---,m::rwx "$__shared_dir"
            fi
        done
{{- if $shared_cache }}
        # Mutable tool caches are account-owned, not shared group stores.
        $SUDO install -d -o dev -g dev -m 2755 "{{ $shared_cache }}"
        for __cache_dir in \
            "{{ $shared_cache }}/mamba" \
            "{{ $shared_cache }}/conda" \
            "{{ $shared_cache }}/uv" \
            "{{ $shared_cache }}/rattler" \
            "{{ $shared_cache }}/npm" \
            "{{ $shared_cache }}/pnpm" \
            "{{ $shared_cache }}/pnpm/store" \
            "{{ $shared_cache }}/pnpm/bin" \
            "{{ $shared_cache }}/pnpm/global" \
            "{{ $shared_cache }}/pnpm/cache" \
            "{{ $shared_cache }}/pnpm/state" \
            "{{ $shared_cache }}/bun" \
            "{{ $shared_cache }}/bun/cache" \
            "{{ $shared_cache }}/bun/global" \
            "{{ $shared_cache }}/bun/bin" \
            "{{ $shared_cache }}/kopia"; do
            $SUDO install -d -o dev -g dev -m 0700 "$__cache_dir"
        done
{{- else }}
        # Legacy profiles keep their shared cache layout when explicitly used.
        for __cache_dir in \
            "{{ $shared }}/.cache" \
            "{{ $shared }}/.cache/uv" \
            "{{ $shared }}/.cache/rattler" \
            "{{ $shared }}/.cache/npm" \
            "{{ $shared }}/.cache/kopia"; do
            $SUDO install -d -o dev -g dev -m 2770 "$__cache_dir"
            if command -v setfacl >/dev/null 2>&1; then
                $SUDO setfacl -m g:dev:rwx,m:rwx "$__cache_dir"
                $SUDO setfacl -d -m u::rwx,g::rwx,o::---,m::rwx "$__cache_dir"
            fi
        done
{{- end }}
    fi
{{- end }}
{{ end -}}
}

# ───────────────────────────────────────────────────────────────
# USER SCOPE — default user (brew / mamba / static binaries / git)
# ───────────────────────────────────────────────────────────────
user_scope() {
    # 1. Git config (unless already set)
    if ! git config --global user.name &>/dev/null; then
        git config --global user.name "{{ .name }}"
        git config --global user.email "{{ .email }}"
        git config --global init.defaultBranch main
        git config --global pull.rebase true
        echo "Git configured"
    fi

{{- if and (eq .chezmoi.os "linux") (hasKey . "shared_cache") .shared_cache }}
    # User-only Incus profile: prepare private mutable caches without sudo.
    for __cache_dir in \
        "{{ .shared_cache }}/mamba" \
        "{{ .shared_cache }}/conda" \
        "{{ .shared_cache }}/uv" \
        "{{ .shared_cache }}/rattler" \
        "{{ .shared_cache }}/npm" \
        "{{ .shared_cache }}/pnpm" \
        "{{ .shared_cache }}/pnpm/store" \
        "{{ .shared_cache }}/pnpm/bin" \
        "{{ .shared_cache }}/pnpm/global" \
        "{{ .shared_cache }}/pnpm/cache" \
        "{{ .shared_cache }}/pnpm/state" \
        "{{ .shared_cache }}/bun" \
        "{{ .shared_cache }}/bun/cache" \
        "{{ .shared_cache }}/bun/global" \
        "{{ .shared_cache }}/bun/bin" \
        "{{ .shared_cache }}/kopia"; do
        mkdir -p "$__cache_dir"
        chmod 0700 "$__cache_dir"
    done
    if [[ ! -f "{{ .shared_cache }}/bun/global/package.json" ]]; then
        printf '%s\n' '{"dependencies":{}}' > "{{ .shared_cache }}/bun/global/package.json"
    fi
{{- else if and (eq .chezmoi.os "linux") (has "dev" .facets) }}
    # Keep Bun's user global root usable on profiles without a shared cache.
    mkdir -p "$HOME/.bun/install/cache" "$HOME/.bun/install/global" "$HOME/.bun/bin"
    if [[ ! -f "$HOME/.bun/install/global/package.json" ]]; then
        printf '%s\n' '{"dependencies":{}}' > "$HOME/.bun/install/global/package.json"
    fi
{{- end }}

    # 2. Mirror-aware Homebrew setup
{{- if .use_china_mirrors }}
    # Git remotes stay with each checkout; only bottles/API use the mirror.
    export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.ustc.edu.cn/homebrew-bottles"
    export HOMEBREW_API_DOMAIN="https://mirrors.ustc.edu.cn/homebrew-bottles/api"
{{- end }}
{{- if and (eq .chezmoi.os "linux") (eq .ownership "personal") (eq .platform "local") (not .is_guest) .homebrew_repository }}
    # Personal Linux profiles always select the forked user overlay, even when
    # the caller inherited the shared base Homebrew PATH. The declared base
    # owner is the exception: its package transaction must target the base so
    # other overlays can inherit the standard package set.
    {{- if .homebrew_manage_base }}
    if [[ -x "{{ .homebrew_base_prefix }}/bin/brew" ]]; then
        eval "$("{{ .homebrew_base_prefix }}/bin/brew" shellenv)"
    fi
    {{- else }}
    if [[ -x "{{ .homebrew_overlay_prefix }}/bin/brew" ]]; then
        eval "$("{{ .homebrew_overlay_prefix }}/bin/brew" shellenv)"
    fi
    {{- end }}
{{- end }}
    export HOMEBREW_NO_AUTO_UPDATE=1
    if ! command -v brew &> /dev/null; then
        if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
            eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
        elif [[ -x /opt/homebrew/bin/brew ]]; then
            eval "$(/opt/homebrew/bin/brew shellenv)"
        fi
    fi
    brew_has() { command -v brew &>/dev/null; }

    # 3. pnpm/bun/pixi PATH exposure handled in shell configs (.zshenv/fish)

    if brew_has; then
        # ───────────────────────────────────────────────────────────
        # L2 BASIC — all non-simple tiers. Shell/dir tooling only;
        # language stack (uv/mamba/node) is L3 (bootstrap=full);
        # pixi is research-facet; pnpm/bun are dev-facet. python -> linux system pkg (no user install).
        # ───────────────────────────────────────────────────────────
        echo "L2 basic tools..."
        __brew_prefix="$(brew --prefix)"
        if [[ ! -w "$__brew_prefix/Cellar" || ! -w "$__brew_prefix/bin" ]]; then
            echo "Homebrew prefix is not writable by $(id -un); package install deferred to its owner"
            return 0
        fi
        brew_install() {
            local __pkg
            for __pkg in "$@"; do
                if brew list --formula "$__pkg" &>/dev/null || brew list --cask "$__pkg" &>/dev/null; then
                    continue
                fi
                if brew info --formula "$__pkg" &>/dev/null; then
                    brew install "$__pkg" 2>/dev/null || echo "Warning: formula install failed: $__pkg"
                elif brew info --cask "$__pkg" &>/dev/null; then
                    brew install --cask "$__pkg" 2>/dev/null || echo "Warning: cask install failed: $__pkg"
                else
                    echo "Warning: no Homebrew formula or cask found: $__pkg"
                fi
            done
        }
        brew_install {{ range .packages.brew.l2 }}{{ . }} {{ end }}
        {{- if eq .os_platform "linux" }}
        brew_install byobu
        brew_install zellij
        {{- end }}
        {{- if eq .chezmoi.os "darwin" }}
        brew_install pngpaste terminal-notifier
        {{- end }}

        # ──── L3 STANDARD (bootstrap=full) ────────────────────────
        {{- if eq .bootstrap "full" }}
        echo "L3 standard tools (bootstrap=full)..."
        brew_install {{ range .packages.brew.l3 }}{{ . }} {{ end }}

        # npm global installs disabled (non-work); npm cache → ~/.cache/npm (see .npmrc)
        {{- if ne .ownership "work" }}
        mkdir -p "$HOME/.npm-global-blocked"
        chmod -R 0500 "$HOME/.npm-global-blocked"
        {{- end }}

        {{- if has "ai" .facets }}
        # AI CLI agents and helpers belong to the ai facet (not generic L3).
        brew install --cask codex claude-code 2>/dev/null || { brew_install codex claude-code 2>/dev/null || echo "Warning: AI CLI agents failed"; }
        {{- end }}

        {{- if eq .chezmoi.os "darwin" }}
        brew_install afsctool duti
        brew install dr-emann/tap/applesauce 2>/dev/null || echo "Warning: applesauce failed"
        brew install --cask aldente fuse-t android-file-transfer cyberduck hammerspoon vesta pearcleaner motrix meld rectangle 2>/dev/null || echo "Warning: some mac casks failed"
        brew install --cask ghostty iterm2 2>/dev/null || echo "Warning: some casks failed: ghostty iterm2"
        brew install --cask font-maple-mono-nf-cn font-meslo-lg-nerd-font font-symbols-only-nerd-font 2>/dev/null || echo "Warning: some font casks failed"
        brew_install kubecolor
        brew_install sing-box
        brew install --cask basictex 2>/dev/null || echo "Warning: basictex cask failed"
        {{- else if or (eq .os_platform "linux") (eq .os_platform "wsl") }}
        {{-   if not .is_headless }}
        brew_install ghostty
        {{-   end }}
        {{- if and (eq .chezmoi.os "linux") (eq .ownership "personal") }}
        brew_install poppler
        __tl_deps=()
        while IFS= read -r __tl_dep; do
            [[ -n "$__tl_dep" && "$__tl_dep" != "mesa" ]] && __tl_deps+=("$__tl_dep")
        done < <(brew deps --direct texlive)
        if (( ${#__tl_deps[@]} > 0 )); then
            brew install "${__tl_deps[@]}" 2>/dev/null || echo "Warning: some texlive deps failed"
        fi
        brew install --ignore-dependencies texlive 2>/dev/null || echo "Warning: texlive install failed"
        {{- end }}
        {{- end }}

        # Cross-platform personal apps (mac+windows, personal ownership)
        {{- if and (or (eq .chezmoi.os "darwin") (eq .chezmoi.os "windows")) (eq .ownership "personal") }}
        brew install --cask android-platform-tools 2>/dev/null || brew_install android-platform-tools 2>/dev/null || echo "Warning: adb failed"
        brew install --cask siyuan obsidian localsend keepassxc zoom windows-app 2>/dev/null || echo "Warning: some personal casks failed"
        {{- end }}

        # Per-user downloaders, mac personal desktop only
        {{- if and (eq .chezmoi.os "darwin") (eq .ownership "personal") (not .is_headless) }}
        brew_install et
        brew_install yt-dlp
        {{- end }}
        {{- end }}

        # ──── facet overlays (any tier) ─────────────────────────────
        {{- if has "dev" .facets }}
        echo "dev facet..."
        brew_install {{ range .packages.facets.dev.brew }}{{ . }} {{ end }}
        {{- if eq .chezmoi.os "darwin" }}
        brew tap openai/tools 2>/dev/null || true
        brew install openai/tools/tart 2>/dev/null || echo "Warning: tart install failed"
        brew_install lima
        brew install --cask ghidra 2>/dev/null || echo "Warning: ghidra cask failed"
        {{- end }}
        {{- if or (eq .os_platform "linux") (eq .os_platform "wsl") }}
        if ! command -v go &>/dev/null; then
            __go_arch="$([ "$(uname -m)" = "aarch64" ] && echo arm64 || echo amd64)"
            curl -fsSL "https://go.dev/dl/go1.24.5.linux-${__go_arch}.tar.gz" | tar xz -C "$HOME" 2>/dev/null || echo "Warning: go install failed"
        fi
        {{- end }}
        if ! command -v cargo &>/dev/null; then curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y 2>/dev/null || echo "Warning: rustup install failed"; fi
        {{- end }}
        {{- if has "proxy" .facets }}
        echo "proxy facet..."
        brew_install {{ range .packages.facets.proxy.brew }}{{ . }} {{ end }}
        {{- end }}
        {{- if has "research" .facets }}
        echo "research facet..."
        brew_install {{ range .packages.facets.research.brew }}{{ . }} {{ end }}
        {{- end }}
        {{- if has "trade" .facets }}
        echo "trade facet..."
        brew_install {{ range .packages.facets.trade.brew }}{{ . }} {{ end }}
        {{- end }}
        {{- if has "hpc" .facets }}
        echo "hpc facet..."
        brew_install {{ range .packages.facets.hpc.brew }}{{ . }} {{ end }}
        {{- end }}
        {{- if has "ai" .facets }}
        echo "ai facet..."
        brew_install {{ range .packages.facets.ai.brew }}{{ . }} {{ end }}
        {{- end }}
        {{- if and (eq .tier "advanced") (has "dev" .facets) }}
        echo "advanced developer tools..."
        brew_install {{ range .packages.tiers.advanced.brew }}{{ . }} {{ end }}
        {{- range .packages.tiers.advanced.brew_head }}
        if ! brew list --formula {{ . }} &>/dev/null; then
            brew install --HEAD {{ . }} 2>/dev/null || echo "Warning: HEAD formula install failed: {{ . }}"
        fi
        {{- end }}
        {{- end }}
        echo "Brew path complete"
    else
        # ── no Homebrew: cloud/HPC — official per-user installers and
        # distro-command aliases. System scope owns rg/fzf/bat packages; do not
        # guess GitHub asset names here (those URLs change between releases).
        echo "probing core tools into ~/.local/bin (no brew)"
        mkdir -p "$HOME/.local/bin"
        if ! command -v starship &>/dev/null; then
            curl -fsSL https://starship.rs/install.sh \
                | sh -s -- -y -b "$HOME/.local/bin" \
                || echo "Warning: starship install failed"
        fi
        if ! command -v zoxide &>/dev/null; then
            curl -fsSL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh \
                | sh -s -- --bin-dir "$HOME/.local/bin" --man-dir "$HOME/.local/share/man" \
                || echo "Warning: zoxide install failed"
        fi
        if ! command -v fd &>/dev/null && command -v fdfind &>/dev/null; then
            ln -sf "$(command -v fdfind)" "$HOME/.local/bin/fd"
        fi
        if ! command -v bat &>/dev/null && command -v batcat &>/dev/null; then
            ln -sf "$(command -v batcat)" "$HOME/.local/bin/bat"
        fi
    fi
}

# ───────────────────────────────────────────────────────────────
# MAIN — deploy matrix by identity
# ───────────────────────────────────────────────────────────────
if [[ "$(id -u)" -eq 0 ]]; then
    # (a) root/system user: ONLY the system scope (deploy=system or system+user)
    if [[ "$RUN_SYSTEM" -eq 1 ]]; then
        if [[ "${SKIP_SYSTEM:-0}" == "1" ]]; then
            echo "=== [skip-system] system scope skipped (root) ==="
        else
            system_scope
        fi
        echo "=== system scope done — user scope runs as default uid (bootstrap-l1.sh drop) ==="
    else
        echo "=== deploy=${DEPLOY} as root: no system scope — user scope is for the default uid ==="
    fi
    exit 0
fi

if [[ "$RUN_USER" -eq 1 ]]; then
    user_scope
fi

if [[ "$RUN_SYSTEM" -eq 1 ]]; then
    if [[ "${SKIP_SYSTEM:-0}" == "1" ]]; then
        echo "=== [skip-system] system scope skipped ==="
    else
        system_scope
    fi
fi

echo "=== Bootstrap Complete ==="
{{- end -}}
