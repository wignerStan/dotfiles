{{- /* Machine Configuration Logic — orthogonal axes:
     ownership (personal|work)         — who owns it (work = stub gate for now)
     platform  (local|cloud)           — where it runs (own hardware vs 3rd-party cloud platform)
     tier      (simple|default|advanced) — resource/install depth (develop renamed advanced)
     facets    (dev|proxy|ai|hpc|research) — stackable capability overlays, ANY tier
     bootstrap (basic|full)            — L2 basic vs L3 full (renamed from setup_mode)
     deploy    (user|system|system+user) — deploy scope: user (default), system,
                                           or both (system+user); plain-user system ops
                                           elevate via sudo; bootstrap-l1 drops root → uid
                                        (drop privileges to default uid 1000/501)

     At `chezmoi init`, precedence per axis is CHEZMOI_* env > machine.toml
     (by user@hostname, then hostname) > auto-detect. The generated config is persistent; for a
     one-off apply use --override-data instead of expecting env to re-render it.
     Legacy CHEZMOI_TIER=develop is translated to tier=advanced + facets+=dev. */ -}}

{{- /* hostname/user (needed for machine.toml profile lookup) */ -}}
{{- $hostname := .chezmoi.hostname -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $hostname = output "scutil" "--get" "LocalHostName" | trim -}}
{{- end -}}

{{- /* machine.toml is parsed directly because .chezmoidata is loaded only
     after config generation; `.machine` is not available at init time. */ -}}
{{- $machine_data := include ".chezmoidata/machine.toml" | fromToml -}}
{{- $machine_cfg := dict -}}
{{- $machine_key := printf "%s@%s" .chezmoi.username $hostname -}}
{{- if and (hasKey $machine_data "machine") (hasKey $machine_data.machine $machine_key) -}}
{{-   $machine_cfg = index $machine_data.machine $machine_key -}}
{{- else if and (hasKey $machine_data "machine") (hasKey $machine_data.machine $hostname) -}}
{{-   $machine_cfg = index $machine_data.machine $hostname -}}
{{- end -}}
{{- $shared_workspace := "" -}}
{{- if hasKey $machine_cfg "shared_workspace" -}}
{{-   $shared_workspace = index $machine_cfg "shared_workspace" | default "" -}}
{{- end -}}

{{- /* guest role: separate from tier (resource depth). Explicit machine data
     wins; Linux/Windows VM models are a fallback. */ -}}
{{- $is_guest := false -}}
{{- if hasKey $machine_cfg "is_guest" -}}
{{-   $is_guest = $machine_cfg.is_guest -}}
{{- else if and (eq .chezmoi.os "linux") (stat "/sys/class/dmi/id/product_name") -}}
{{-   $pn := output "cat" "/sys/class/dmi/id/product_name" | trim -}}
{{-   if or (contains "Virtual" $pn) (contains "KVM" $pn) (contains "QEMU" $pn) (contains "Parallels" $pn) -}}
{{-     $is_guest = true -}}
{{-   end -}}
{{- else if and (eq .chezmoi.os "windows") (lookPath "powershell") -}}
{{-   $pn := output "powershell" "-NoProfile" "-NonInteractive" "-Command" "(Get-CimInstance Win32_ComputerSystem).Model" | trim -}}
{{-   if or (contains "Virtual" $pn) (contains "VMware" $pn) (contains "QEMU" $pn) (contains "Parallels" $pn) (contains "VirtualBox" $pn) -}}
{{-     $is_guest = true -}}
{{-   end -}}
{{- end -}}

{{- /* ownership: who the machine belongs to (personal|work). default: personal. */ -}}
{{- $ownership := "personal" -}}
{{- if env "CHEZMOI_OWNERSHIP" -}}
{{-   $ownership = env "CHEZMOI_OWNERSHIP" -}}
{{- else if hasKey $machine_cfg "ownership" -}}
{{-   $ownership = $machine_cfg.ownership -}}
{{- end -}}

{{- /* platform: local (own hardware) vs cloud (3rd-party platform: VPS/HPC/codespace). */ -}}
{{- $platform := "local" -}}
{{- if env "CHEZMOI_PLATFORM" -}}
{{-   $platform = env "CHEZMOI_PLATFORM" -}}
{{- else if hasKey $machine_cfg "platform" -}}
{{-   $platform = $machine_cfg.platform -}}
{{- else if or (env "CODESPACES") (env "REMOTE_CONTAINERS_IPC") -}}
{{-   $platform = "cloud" -}}
{{- else if or (lookPath "apptainer") (lookPath "singularity") -}}
{{-   $platform = "cloud" -}}
{{- end -}}

{{- /* tier: simple | default | advanced
     - simple:   minimal/1C1G resource depth; primary_shell = bash
     - default:  fallback — standard zsh
     - advanced: dev user (formerly "develop") — standard zsh
     Auto-detect dev/cal/simple by identity/VM; if none match, tier stays "default". */ -}}
{{- $tier := "default" -}}
{{- if env "CHEZMOI_TIER" -}}
{{-   $tier = env "CHEZMOI_TIER" -}}
{{- else if hasKey $machine_cfg "tier" -}}
{{-   $tier = $machine_cfg.tier -}}
{{- else if eq .chezmoi.username "dev" -}}
{{-   $tier = "advanced" -}}
{{- else if or (env "CODESPACES") (env "REMOTE_CONTAINERS_IPC") $is_guest -}}
{{-   $tier = "simple" -}}
{{- end -}}
{{- /* legacy CHEZMOI_TIER=develop → advanced + dev facet */ -}}
{{- $legacyDevelop := eq $tier "develop" -}}
{{- if eq $tier "develop" -}}
{{-   $tier = "advanced" -}}
{{- end -}}

{{- /* facets: stackable capability overlays (dev|proxy|ai|hpc|research), ANY tier may carry
     them. Sources: CHEZMOI_FACETS env (space/comma list) > machine.toml.
     Auto-added: hpc on apptainer/singularity hosts or cal user; dev for dev user
     (or legacy "develop" tier). */ -}}
{{- $facets := list -}}
{{- if env "CHEZMOI_FACETS" -}}
{{-   range (replace "," " " (env "CHEZMOI_FACETS") | splitList " ") -}}
{{-     if ne . "" -}}{{- $facets = append $facets . -}}{{- end -}}
{{-   end -}}
{{- else if hasKey $machine_cfg "facets" -}}
{{-   $facets = $machine_cfg.facets -}}
{{- end -}}
{{- if or (lookPath "apptainer") (lookPath "singularity") -}}
{{-   if not (has "hpc" $facets) -}}{{- $facets = append $facets "hpc" -}}{{- end -}}
{{- end -}}
{{- if and (eq .chezmoi.username "cal") (eq .chezmoi.os "linux") -}}
{{-   if not (has "hpc" $facets) -}}{{- $facets = append $facets "hpc" -}}{{- end -}}
{{- end -}}
{{- if or (eq .chezmoi.username "dev") $legacyDevelop -}}
{{-   if not (has "dev" $facets) -}}{{- $facets = append $facets "dev" -}}{{- end -}}
{{- end -}}

{{- /* bootstrap: basic | full. L2 = basic breadth, L3 = full (packages + services).
     Orthogonal to ownership/platform/tier. */ -}}
{{- $bootstrap := "basic" -}}
{{- if env "CHEZMOI_BOOTSTRAP" -}}
{{-   $bootstrap = env "CHEZMOI_BOOTSTRAP" -}}
{{- else if hasKey $machine_cfg "bootstrap" -}}
{{-   $bootstrap = $machine_cfg.bootstrap -}}
{{- else if and (eq $ownership "personal") (ne $tier "simple") -}}
{{-   $bootstrap = "full" -}}
{{- end -}}

{{- /* deploy: user (default) | system | system+user — orthogonal axis over
     package/service deployment scope.
       user        → user scope only (brew, mamba, shell, home configs)
       system      → system scope only (system packages, /etc services);
                     a plain user runs it via sudo elevation
       system+user → both scopes: a plain user runs user then sudo system;
                     root runs system only (bootstrap-l1 owns privilege drop).
     Init precedence: CHEZMOI_DEPLOY env > machine.toml > "user" (default).
     Per-apply override: --override-data '{"deploy":"..."}'. */ -}}
{{- $deploy := "user" -}}
{{- if env "CHEZMOI_DEPLOY" -}}
{{-   $deploy = env "CHEZMOI_DEPLOY" -}}
{{- else if hasKey $machine_cfg "deploy" -}}
{{-   $deploy = $machine_cfg.deploy -}}
{{- end -}}
{{- $is_root := false -}}
{{- if eq .chezmoi.uid "0" -}}
{{-   $is_root = true -}}
{{- end -}}
{{- $default_uid := "1000" -}}
{{- if eq .chezmoi.os "darwin" -}}{{- $default_uid = "501" -}}{{- end -}}

{{- /* primary_shell: simple → bash everywhere; standard (default/advanced) → zsh */ -}}
{{- $primary_shell := "zsh" -}}
{{- if eq $tier "simple" -}}
{{-   $primary_shell = "bash" -}}
{{- end -}}

{{- /* mamba envs (L3 base + facet envs). Base env composition = core only;
     facet-env manifests (dev→develop etc.) are separate envs, created by
     mamba-sync-base.{sh,ps1} per facet — NOT merged into base. */ -}}
{{- $mamba_sections := list "core" -}}

{{- /* headless: no real desktop session */ -}}
{{- $headless := false -}}
{{- if eq $platform "cloud" -}}
{{-   $headless = true -}}
{{- else if eq .chezmoi.os "linux" -}}
{{-   if not (or (env "DISPLAY") (env "WAYLAND_DISPLAY")) -}}
{{-     $headless = true -}}
{{-   else if not (lookPath "gnome-session") -}}
{{-     $headless = true -}}
{{-   end -}}
{{- end -}}

{{- /* Derived */ -}}
{{- $ephemeral := eq $platform "cloud" -}}

{{- /* OS platform: detect WSL2 (chezmoi reports "linux" for WSL2).
     Distinct from the local/cloud platform axis — this is the OS kind. */ -}}
{{- $os_platform := .chezmoi.os -}}
{{- if and (eq .chezmoi.os "linux") (stat "/proc/version") -}}
{{-   $procver := lower (output "cat" "/proc/version") -}}
{{-   if contains "microsoft" $procver -}}
{{-     $os_platform = "wsl" -}}
{{-   end -}}
{{- end -}}

{{- /* Geo location detection (timezone-based, cross-platform: macOS/Linux/Windows) */ -}}
{{- /* macOS has no /etc/timezone; readlink /etc/localtime works on macOS + Linux. */ -}}
{{- /* Windows has neither — tzutil /g returns the English standard name. */ -}}
{{- /* Guard every shell-out so a missing binary/file can't crash rendering. */ -}}
{{- $geo := "us" -}}
{{- $tz := "" -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   if lookPath "tzutil" -}}
{{-     $tz = output "tzutil" "/g" | trim -}}
{{-   end -}}
{{- else if stat "/etc/localtime" -}}
{{-   $tz = output "readlink" "/etc/localtime" | trim -}}
{{- else if stat "/etc/timezone" -}}
{{-   $tz = output "cat" "/etc/timezone" | trim -}}
{{- end -}}
{{- if or (contains "Asia" $tz) (contains "PRC" $tz) (contains "China" $tz) -}}
{{-   $geo = "cn" -}}
{{- end -}}
{{- $use_china_mirrors := eq $geo "cn" -}}

{{- /* Detection: age encryption identity available */ -}}
{{- $age_identity := joinPath .chezmoi.homeDir ".config/chezmoi/age-key.txt" -}}
{{- $has_age := false -}}
{{- if stat $age_identity -}}
{{-   $has_age = true -}}
{{- end -}}

{{- /* Reject invalid machine/env declarations before persisting them. */ -}}
{{- $axesValidated := includeTemplate "validate-axes" (dict "ownership" $ownership "platform" $platform "tier" $tier "bootstrap" $bootstrap "deploy" $deploy "facets" $facets "is_guest" $is_guest) -}}

{{- /* Custom Prompts — only prompt during interactive chezmoi init */ -}}
{{- $github_user := "" -}}
{{- $name := "Jacob" -}}
{{- $email := "240170694+wignerStan@users.noreply.github.com" -}}
{{- if stdinIsATTY -}}
{{-   $github_user = promptStringOnce . "github_user" "What is your GitHub username?" "" -}}
{{-   $name = promptStringOnce . "name" "What is your name?" "Jacob" -}}
{{-   $email = promptStringOnce . "email" "What is your email?" $email -}}
{{- end -}}

{{ if $has_age }}
encryption = "age"

[age]
    identity = {{ $age_identity | quote }}
    recipient = "age1s5nfmrjdljyh2hz3nary72zm5478dyrrsudgph043hmgs7c8gy4sc3ys0c"
{{ end }}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    github_user = {{ $github_user | quote }}
    hostname = {{ $hostname | quote }}
    ownership = {{ $ownership | quote }}
    platform = {{ $platform | quote }}
    os_platform = {{ $os_platform | quote }}
    tier = {{ $tier | quote }}
    facets = {{ $facets | toJson }}
    bootstrap = {{ $bootstrap | quote }}
    deploy = {{ $deploy | quote }}
    is_root = {{ $is_root }}
    is_guest = {{ $is_guest }}
    default_uid = {{ $default_uid | quote }}
    primary_shell = {{ $primary_shell | quote }}
    is_ephemeral = {{ $ephemeral }}
    is_headless = {{ $headless }}
    mamba_sections = {{ $mamba_sections | toJson }}
    shared_workspace = {{ $shared_workspace | quote }}
    use_china_mirrors = {{ $use_china_mirrors }}
    geo = {{ $geo | quote }}
    mamba_root = {{ if $shared_workspace }}{{ joinPath $shared_workspace "mamba" | quote }}{{ else }}{{ joinPath .chezmoi.homeDir "mamba" | quote }}{{ end }}
    arch = {{ .chezmoi.arch | quote }}
