{{- /* Machine Configuration Logic — three independent axes */ -}}

{{- /* Axis 1: profile (primary identity — exactly one) */ -}}
{{- $profile := "personal" -}}
{{- if or (env "CODESPACES") (env "REMOTE_CONTAINERS_IPC") (eq .chezmoi.username "root" "ubuntu") -}}
{{-   $profile = "vps" -}}
{{- end -}}
{{- /* HPC cluster (has apptainer/singularity on host) */ -}}
{{- if or (lookPath "apptainer") (lookPath "singularity") -}}
{{-   $profile = "hpc" -}}
{{- end -}}

{{- /* Axis 2: develop (composition layer — additive dev tooling) */ -}}
{{- $develop := false -}}
{{- if eq .chezmoi.username "dev" -}}
{{-   $develop = true -}}
{{- end -}}

{{- /* Axis 3: headless (no real desktop session) */ -}}
{{- $headless := false -}}
{{- if or (eq $profile "vps") (eq $profile "hpc") -}}
{{-   $headless = true -}}
{{- else if eq .chezmoi.os "linux" -}}
{{-   if not (or (env "DISPLAY") (env "WAYLAND_DISPLAY")) -}}
{{-     $headless = true -}}
{{-   else if not (lookPath "gnome-session") -}}
{{-     $headless = true -}}
{{-   end -}}
{{- end -}}

{{- /* Axis 4: is_vm — guest VM (Parallels/VMware/VirtualBox/QEMU), not bare metal.
     Used to apply a simplified profile: skip host-specific daemons (sing-box TUN
     proxy, Homebrew trust sync, etc.) that have no meaning or won't run in a guest. */ -}}
{{- $is_vm := false -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   if lookPath "powershell" -}}
{{-     $model := output "powershell" "-NoProfile" "-Command" "(Get-CimInstance Win32_ComputerSystem).Model" | trim -}}
{{-     if or (contains "Parallels" $model) (contains "VMware" $model) (contains "VirtualBox" $model) -}}
{{-       $is_vm = true -}}
{{-     end -}}
{{-   end -}}
{{- else if eq .chezmoi.os "linux" -}}
{{-   if stat "/sys/class/dmi/id/product_name" -}}
{{-     $pn := output "cat" "/sys/class/dmi/id/product_name" | trim -}}
{{-     if or (contains "Parallels" $pn) (contains "VMware" $pn) (contains "VirtualBox" $pn) (contains "QEMU" $pn) (contains "KVM" $pn) -}}
{{-       $is_vm = true -}}
{{-     end -}}
{{-   end -}}
{{- end -}}

{{- /* Derived */ -}}
{{- $ephemeral := or (eq $profile "vps") (eq $profile "hpc") -}}

{{- /* Geo location detection (timezone-based, cross-platform: macOS/Linux/Windows) */ -}}
{{- /* macOS has no /etc/timezone; readlink /etc/localtime works on macOS + Linux. */ -}}
{{- /* Windows has neither — tzutil /g returns the English standard name. */ -}}
{{- /* Guard every shell-out so a missing binary/file can't crash rendering. */ -}}
{{- $geo := "us" -}}
{{- $tz := "" -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   if lookPath "tzutil" -}}
{{-     $tz = output "tzutil" "/g" | trim -}}
{{-   end -}}
{{- else if stat "/etc/localtime" -}}
{{-   $tz = output "readlink" "/etc/localtime" | trim -}}
{{- else if stat "/etc/timezone" -}}
{{-   $tz = output "cat" "/etc/timezone" | trim -}}
{{- end -}}
{{- if or (contains "Asia" $tz) (contains "PRC" $tz) (contains "China" $tz) -}}
{{-   $geo = "cn" -}}
{{- end -}}
{{- $use_china_mirrors := eq $geo "cn" -}}

{{- /* Detection: age encryption identity available */ -}}
{{- $age_identity := joinPath .chezmoi.homeDir ".config/chezmoi/age-key.txt" -}}
{{- $has_age := false -}}
{{- if stat $age_identity -}}
{{-   $has_age = true -}}
{{- end -}}

{{- $hostname := .chezmoi.hostname -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $hostname = output "scutil" "--get" "LocalHostName" | trim -}}
{{- end -}}

{{- /* Custom Prompts — only prompt during interactive chezmoi init */ -}}
{{- $github_user := "" -}}
{{- $name := "Jacob" -}}
{{- $email := "240170694+wignerStan@users.noreply.github.com" -}}
{{- if stdinIsATTY -}}
{{-   $github_user = promptStringOnce . "github_user" "What is your GitHub username?" "" -}}
{{-   $name = promptStringOnce . "name" "What is your name?" "Jacob" -}}
{{-   $email = promptStringOnce . "email" "What is your email?" $email -}}
{{- end -}}

{{ if $has_age }}
encryption = "age"

[age]
    identity = {{ $age_identity | quote }}
    recipient = "age1s5nfmrjdljyh2hz3nary72zm5478dyrrsudgph043hmgs7c8gy4sc3ys0c"
{{ end }}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    github_user = {{ $github_user | quote }}
    hostname = {{ $hostname | quote }}
    primary_shell = "zsh"
    is_ephemeral = {{ $ephemeral }}
    is_headless = {{ $headless }}
    is_vm = {{ $is_vm }}
    use_china_mirrors = {{ $use_china_mirrors }}
    geo = {{ $geo | quote }}
    profile = {{ $profile | quote }}
    develop = {{ $develop }}
    mamba_root = {{ joinPath .chezmoi.homeDir "mamba" | quote }}
    arch = {{ .chezmoi.arch | quote }}

    # Paths for modern tools
    ghostty_config = "~/.config/ghostty/config"
    nvim_config = "~/.config/nvim"

{{- if lookPath "delta" }}
[diff]
    pager = "delta"
{{- else if lookPath "bat" }}
[diff]
    pager = "bat --style=changes"
{{- end }}
