{{- /* Windows: reconcile the mamba base env and facet-specific envs.
     chezmoi run_onchange trigger; idempotent. */ -}}
{{- if and (eq .chezmoi.os "windows") (eq .bootstrap "full") (ne .tier "simple") (lookPath "micromamba") -}}
#powershell
$ErrorActionPreference = 'SilentlyContinue'
$ProgressPreference = 'SilentlyContinue'
$env:Path = [Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [Environment]::GetEnvironmentVariable('Path','User')
$env:MAMBA_ROOT_PREFIX = '{{ .mamba_root }}'
function Log($m){ Write-Host "[mamba-sync] $m" }

$mm = Get-Command micromamba -EA SilentlyContinue
if (-not $mm) { $mm = Get-Command mamba -EA SilentlyContinue }
if (-not $mm) { Log 'no micromamba/mamba found, skipping'; exit 0 }
$mm = $mm.Source
if (-not (& $mm env list 2>$null | Select-String -Quiet '\bbase\b')) { Log 'base env not present, skipping'; exit 0 }

$channels = @({{- range .mamba_base.channels }} '{{ . }}' {{- end }}) | ForEach-Object { @('-c', $_) }
# core + facet sections (.mamba_sections from .chezmoi.toml.tmpl)
$condaPkgs = @({{- range .mamba_sections }}{{- range (index $.mamba_base .).conda }} '{{ . }}' {{- end }}{{- end }})
$pipPkgs   = @({{- range .mamba_sections }}{{- range (index $.mamba_base .).pip }} '{{ . }}' {{- end }}{{- end }})

if ($condaPkgs.Count -gt 0) {
    Log "ensuring conda packages (tier={{ .tier }} sections={{ .mamba_sections | join "," }}): $($condaPkgs -join ' ')"
    & $mm install -y -n base @channels @condaPkgs 2>&1 | Out-Null
}
if ($pipPkgs.Count -gt 0) {
    Log "ensuring pip packages: $($pipPkgs -join ' ')"
    & $mm run -n base python -m pip install --upgrade @pipPkgs 2>&1 | Out-Null
}
{{- if has "dev" .facets }}
# The dev facet owns a separate Python 3.12 environment; never merge it into
# base, whose scientific stack follows the current conda-forge Python.
$devEnv = Join-Path $HOME '.conda\envs\develop'
$devConda = @({{- range (index .mamba_base "dev").conda }} '{{ . }}' {{- end }})
$devPip = @({{- range (index .mamba_base "dev").pip }} '{{ . }}' {{- end }})
if (-not (Test-Path $devEnv)) {
    Log "creating develop env at $devEnv"
    & $mm create -y -p $devEnv @channels 'python=3.12' 'pip' 'uv' @devConda 2>&1 | Out-Null
} elseif ($devConda.Count -gt 0) {
    & $mm install -y -p $devEnv @channels @devConda 2>&1 | Out-Null
}
if ((Test-Path $devEnv) -and $devPip.Count -gt 0) {
    & $mm run -p $devEnv python -m pip install --upgrade @devPip 2>&1 | Out-Null
}
Log 'develop env sync complete'
{{- end }}
{{- if has "trade" .facets }}
$tradeEnv = Join-Path $HOME '.conda\envs\trade'
$tradeConda = @({{- range (index .mamba_base "trade").conda }} '{{ . }}' {{- end }})
$tradePip = @({{- range (index .mamba_base "trade").pip }} '{{ . }}' {{- end }})
if (-not (Test-Path $tradeEnv)) {
    Log "creating trade env at $tradeEnv"
    & $mm create -y -p $tradeEnv @channels 'python=3.12' 'pip' 'uv' @tradeConda 2>&1 | Out-Null
} elseif ($tradeConda.Count -gt 0) {
    & $mm install -y -p $tradeEnv @channels @tradeConda 2>&1 | Out-Null
}
if ((Test-Path $tradeEnv) -and $tradePip.Count -gt 0) {
    & $mm run -p $tradeEnv python -m pip install --upgrade @tradePip 2>&1 | Out-Null
}
Log 'trade env sync complete'
{{- end }}
Log "sync complete (tier={{ .tier }})"{{- end -}}
