{{- /* Windows-only: renders empty on macOS/Linux, so chezmoi skips execution there. */ -}}
{{- if eq .chezmoi.os "windows" -}}
#powershell
# ═══════════════════════════════════════════════════════════════
# Jacob's Windows Bootstrap — winget-first, scoop-fallback
# Idempotent (safe to re-run via run_onchange). profile={{ .profile }}
# Principle: winget is the primary package manager; scoop is the
# fallback for anything winget lacks. uv + micromamba come from winget.
# ═══════════════════════════════════════════════════════════════
# Managed by Chezmoi — runs on Windows only. Do not edit in place.

$ErrorActionPreference = 'Stop'
$ProgressPreference    = 'SilentlyContinue'

function Write-Step($m){ Write-Host "==> $m" -ForegroundColor Cyan }
function Write-Ok($m){    Write-Host "    ok: $m" -ForegroundColor Green }
function Write-Skip($m){  Write-Host "    skip: $m (already present)" -ForegroundColor DarkGray }

# Refresh PATH (winget/scoop write to Machine+User env; this session needs them now).
function Update-EnvPath {
    $env:Path = [Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [Environment]::GetEnvironmentVariable('Path','User')
}
Update-EnvPath

function Test-Cmd($n) { return [bool](Get-Command $n -ErrorAction SilentlyContinue) }

Write-Step "Starting Windows Bootstrap (profile={{ .profile }} geo={{ .geo }})"

# ── 1. winget (primary package manager) ──────────────────────────
# App Installer (winget) ships with Win11 and self-updates; we only ensure it's callable.
if (Test-Cmd 'winget') {
    Write-Skip 'winget'
} else {
    Write-Step "winget missing — registering App Installer from the Store (ms-windows-store:)"
    try {
        Start-Process 'ms-windows-store:' -ErrorAction SilentlyContinue
        Write-Host "    Opened Microsoft Store to 'App Installer' — install it, then re-run chezmoi." -ForegroundColor Yellow
    } catch {
        Write-Host "    Could not open Store automatically. Install 'App Installer' from the Store." -ForegroundColor Yellow
    }
}

# ── 2. scoop (fallback package manager, user-scoped, no admin) ────
# Only on bare-metal Windows. Guest VMs use winget exclusively (scoop's
# installer is blocked by the security manager on the UNC working dir that
# chezmoi run_ scripts execute from, and the VM has no need for scoop).
{{- if not (eq .tier "simple") }}
if (Test-Cmd 'scoop') {
    Write-Skip 'scoop'
} else {
    Write-Step "Installing scoop (fallback package manager)..."
    try {
        # scoop's official installer
        Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser -ErrorAction SilentlyContinue
        Invoke-RestMethod -Uri https://get.scoop.sh | Invoke-Expression
        Update-EnvPath
        if (Test-Cmd 'scoop') { Write-Ok 'scoop installed' } else { Write-Host "    scoop install did not land on PATH (restart shell)" -ForegroundColor Yellow }
    } catch {
        Write-Host "    scoop install failed: $($_.Exception.Message)" -ForegroundColor Yellow
    }
}
{{- end }}

# Generic installer helper: try winget first, fall back to scoop.
# Usage: Install-Tool -WingetId 'X.Y' -ScoopName 'x' -BinName 'x' -Label 'X'
function Install-Tool {
    param(
        [string]$WingetId,
        [string]$ScoopName,
        [string]$BinName,
        [string]$Label
    )
    if (Test-Cmd $BinName) { Write-Skip $Label; return $true }

    # winget first
    if (Test-Cmd 'winget') {
        Write-Step "$Label — winget install $WingetId"
        & winget install --id $WingetId -e --source winget `
            --accept-source-agreements --accept-package-agreements `
            --disable-interactivity --silent 2>&1 |
            ForEach-Object { Write-Host "    $_" -ForegroundColor DarkGray } ; $code = $LASTEXITCODE
        Update-EnvPath
        if (Test-Cmd $BinName) { Write-Ok "$Label via winget"; return $true }
    }

    # scoop fallback
    if (Test-Cmd 'scoop') {
        Write-Step "$Label — fallback: scoop install $ScoopName"
        & scoop install $ScoopName 2>&1 |
            ForEach-Object { Write-Host "    $_" -ForegroundColor DarkGray }
        Update-EnvPath
        if (Test-Cmd $BinName) { Write-Ok "$Label via scoop"; return $true }
    }

    Write-Host "    FAILED to install $Label (no working winget/scoop result)" -ForegroundColor Red
    return $false
}

# ── 3. uv (Astral — fast Python/Rust package mgr). winget: astral-sh.uv ──
{{- if .use_china_mirrors }}
$env:UV_DEFAULT_INDEX = 'https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple'
{{- end }}
Install-Tool -WingetId 'astral-sh.uv' -ScoopName 'uv' -BinName 'uv' -Label 'uv'

# ── 4. micromamba (mamba). winget: Mamba.Micromamba ──────────────
# mamba_root is set by chezmoi config ({{ .mamba_root }}); ensure root + base exist.
$mambaRoot = '{{ .mamba_root }}'
[Environment]::SetEnvironmentVariable('MAMBA_ROOT_PREFIX', $mambaRoot, 'User')
$env:MAMBA_ROOT_PREFIX = $mambaRoot
if (-not (Test-Path $mambaRoot)) { New-Item -ItemType Directory -Force -Path $mambaRoot | Out-Null }

$mmOk = Install-Tool -WingetId 'Mamba.Micromamba' -ScoopName 'micromamba' -BinName 'micromamba' -Label 'micromamba'

# micromamba shell init (powershell) + ensure the base (root) env has python.
# When MAMBA_ROOT_PREFIX is set, "base" == the root prefix, so `create -n base`
# fails with "Overwriting root prefix is not permitted". Install python INTO the
# root prefix directly with `install ... -r <root>` instead.
if ($mmOk -and (Test-Cmd 'micromamba')) {
    Update-EnvPath
    try {
        & micromamba shell init -s powershell -r $mambaRoot 2>&1 | Out-Null
        # base (root) env gets a python — single source of Python on the box
        if (-not (Test-Path "$mambaRoot\python.exe")) {
            Write-Step "Installing python into mamba base (root prefix)"
            & micromamba install -y -c conda-forge python -r $mambaRoot 2>&1 |
                ForEach-Object { Write-Host "    $_" -ForegroundColor DarkGray }
        }
        Write-Ok 'micromamba base env ready'
    } catch {
        Write-Host "    micromamba env init warning: $($_.Exception.Message)" -ForegroundColor Yellow
    }
}

Write-Step "Windows Bootstrap Complete"
Write-Host "    Restart PowerShell to pick up new PATH entries (winget/scoop/uv/micromamba)." -ForegroundColor Yellow

# ═══════════════════════════════════════════════════════════════
# Win11Debloat — unattended system cleanup/tweaks (Raphire/Win11Debloat)
# Always runs (idempotent: re-applying the same tweaks is a no-op).
# Aggressiveness by tier:
#   simple (VM/container)        -> RunDefaults + extra removals (bloatware off)
#   standard / develop           -> RunDefaultsLite (tweaks only, NO app removal)
# Always: -Silent (no prompts), -CreateRestorePoint.
# ═══════════════════════════════════════════════════════════════
Write-Step "Win11Debloat (unattended, tier={{ .tier }})"
try {
    $debloatFlags = @(
        '-Silent'
        '-CreateRestorePoint'
        # universal tweaks everyone wants
        '-DisableTelemetry'
        '-DisableSuggestions'
        '-DisableBing'
        '-DisableEdgeAds'
        '-DisableLockscreenTips'
        '-RevertContextMenu'
        '-ShowKnownFileExt'
        '-ShowHiddenFolders'
        '-EnableDarkMode'
    )
    {{- if eq .tier "simple" }}
    # VM/container: aggressive — full bloatware removal + extra privacy/AI disablement
    $debloatFlags += @(
        '-RunDefaults'                 # removes default app selection (Xbox, Clipchamp, ...)
        '-AppRemovalTarget' 'AllUsers'
        '-DisableCopilot'
        '-DisableWidgets'
        '-DisableRecall'
        '-DisableClickToDo'
        '-DisableStoreSearchSuggestions'
        '-DisableDesktopSpotlight'
    )
    {{- else }}
    # standard/develop bare metal: conservative — tweaks only, keep apps
    $debloatFlags += @('-RunDefaultsLite')
    {{- end }}

    # Fetch the script directly from GitHub (not the raphi.re launcher), then run.
    Write-Host "    fetching Win11Debloat.ps1 from github..." -ForegroundColor DarkGray
    $debloatScript = Invoke-RestMethod -Uri 'https://raw.githubusercontent.com/Raphire/Win11Debloat/master/Win11Debloat.ps1' -UseBasicParsing
    $sb = [scriptblock]::Create($debloatScript)
    & $sb @debloatFlags 2>&1 |
        ForEach-Object { Write-Host "    $_" -ForegroundColor DarkGray }
    Write-Ok 'Win11Debloat applied'
} catch {
    Write-Host "    Win11Debloat warning: $($_.Exception.Message)" -ForegroundColor Yellow
}
{{- end -}}
