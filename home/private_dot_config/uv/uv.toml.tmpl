# uv config — managed by chezmoi
{{- /* Resolved per-user machine profile; empty means user-local caches. */ -}}
{{- $shared := "" -}}
{{- if hasKey . "shared_workspace" }}{{- $shared = .shared_workspace | default "" }}{{- end -}}
{{- if $shared }}
# Shared cache on {{ $shared }}/.cache (same btrfs filesystem as project venvs → reflinks)
cache-dir = "{{ $shared }}/.cache/uv"
link-mode = "clone"
{{- end }}

{{- if .use_china_mirrors }}
[[index]]
url = "https://pypi.tuna.tsinghua.edu.cn/simple"
default = true
{{- end }}
