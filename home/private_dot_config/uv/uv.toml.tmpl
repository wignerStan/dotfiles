# uv config — managed by chezmoi
{{- /* Resolved per-user cache root; empty means user-local caches. */ -}}
{{- $shared_cache := "" -}}
{{- if hasKey . "shared_cache" }}{{- $shared_cache = .shared_cache | default "" -}}{{- end -}}
{{- if $shared_cache }}
# Account-scoped cache under the shared workspace (same filesystem → reflinks)
cache-dir = "{{ $shared_cache }}/uv"
link-mode = "clone"
{{- end }}

{{- if .use_china_mirrors }}
[[index]]
url = "https://pypi.tuna.tsinghua.edu.cn/simple"
default = true
{{- end }}
