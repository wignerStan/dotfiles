{{- if hasKey . "singbox_server" -}}
#!/bin/bash
# On-demand, ephemeral sing-box SERVER: inject a subscription into a minimal
# server scaffold (single mixed inbound, fake-ip routing only, no cache).
#   - fake-ip range differs from the main instance (172.22.0.0/16 :: fd00:22::/64)
#   - no cache_file / no fake-ip DNS persistence, everything under /tmp
#   - user-level (no TUN, no root), runs in foreground, cleanup on exit
set -euo pipefail

SRC="{{ .chezmoi.homeDir }}/.config/sing-box"
TMP="$(mktemp -d /tmp/sing-box-temp.XXXXXX)"
trap 'rm -rf "$TMP"' EXIT

if [[ $# -lt 1 || -z "$1" ]]; then
    echo "usage: sing-box-temp.sh <subscription-url> [port] [listen]" >&2
    exit 1
fi
SUB_URL="$1"
PORT="${2:-10810}"
LISTEN="${3:-127.0.0.1}"

# build the minimal server scaffold: everything the client instance uses is
# left out (no tun, no clash api, no cache, no services, no mirrors)
python3 - "$TMP/base.json" "$PORT" "$LISTEN" <<'PY'
import json, sys
path, port, listen = sys.argv[1], int(sys.argv[2]), sys.argv[3]
scaffold = {
    "log": {"level": "debug", "timestamp": True},
    "dns": {
        "servers": [
            {
                "type": "fakeip",
                "tag": "dns-fakeip",
                "inet4_range": "172.22.0.0/16",
                "inet6_range": "fd00:22::/64",
            },
            {
                "type": "local",
                "tag": "local",
            },
        ],
        "rules": [{"action": "route", "server": "dns-fakeip"}],
        "final": "local",
    },
    "inbounds": [
        {
            "type": "mixed",
            "tag": "mixed-in",
            "listen": listen,
            "listen_port": int(port),
        }
    ],
    "outbounds": [
        {"type": "selector", "tag": "proxy", "outbounds": ["direct"]},
        {"type": "direct", "tag": "direct"},
    ],
    "route": {
        "rules": [
            {"action": "sniff"},
            {"protocol": "dns", "action": "hijack-dns"},
        ],
        "final": "proxy",
        "auto_detect_interface": True,
        "default_domain_resolver": "dns-fakeip",
    },
}
json.dump(scaffold, open(path, "w"), indent=2)
PY

python3 "$SRC/inject-sub.py" -s "$SUB_URL" -o "$TMP/config.json" < "$TMP/base.json"

if ! sing-box check -c "$TMP/config.json" 2>&1; then
    echo "sing-box-temp: config validation FAILED" >&2
    exit 1
fi

echo "sing-box-temp: server on $LISTEN:$PORT (fake-ip 172.22.0.0/16, no cache, Ctrl-C to stop)"
sing-box run -c "$TMP/config.json" --directory "$TMP"
{{- end -}}