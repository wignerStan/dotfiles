{{- /* Resolved per-user cache root; unset means user-local caches. */ -}}
{{- $shared_cache := "" -}}
{{- if hasKey . "shared_cache" }}{{- $shared_cache = .shared_cache | default "" }}{{- end -}}
# ── Mamba (global Python base environment; L3 standard) ────────────────
{{- if eq .bootstrap "full" }}
set -gx MAMBA_ROOT_PREFIX {{ .mamba_root | quote }}
if set -q HOMEBREW_PREFIX; and test -x "$HOMEBREW_PREFIX/opt/micromamba/bin/mamba"
    set -gx MAMBA_EXE "$HOMEBREW_PREFIX/opt/micromamba/bin/mamba"
else if type -q micromamba
    set -gx MAMBA_EXE (command -s micromamba)
else if type -q mamba
    set -gx MAMBA_EXE (command -s mamba)
end
fish_add_path --move "$MAMBA_ROOT_PREFIX/bin"
if status is-login; and set -q MAMBA_EXE
    $MAMBA_EXE shell hook --shell fish --root-prefix "$MAMBA_ROOT_PREFIX" 2>/dev/null | source
{{- if has "dev" .facets }}
    mamba activate develop 2>/dev/null
{{- end }}
end
{{- end }}

# ── Pixi (project Python environments; research facet) ──────────────────
{{- if has "research" .facets }}
if type -q pixi
    set -gx PIXI_HOME ~/.pixi
    fish_add_path --move $PIXI_HOME/bin
    {{- /* pixi wheels reuse the account-scoped uv cache; unset ⇒ pixi defaults */}}
    {{- if $shared_cache }}
    set -gx PIXI_CACHE_PYPI_WHEELS_DIR {{ $shared_cache }}/uv
    set -gx PIXI_CACHE_DIR {{ $shared_cache }}/rattler
    {{- end }}
end
{{- end }}
# ── Account-scoped uv cache (reflinks with project venvs) ──
{{- if $shared_cache }}
set -gx UV_CACHE_DIR {{ $shared_cache }}/uv
set -gx UV_LINK_MODE clone
{{- end }}
