# Gating: work, or personal desktop (macOS/Windows).
{{- if or (eq .profile "work") (eq .profile "personal") }}
# Gate on the binary existing so non-Homebrew machines skip cleanly.
# exported in non-login shells (matching .zshenv).

    # Shell hook + activate costs ~30ms of forks; only run for login shells.
    if status is-login
    end
end
{{- end }}

# ── Pixi (project Python environments) ──────────────────────
{{- if eq .tier "develop" }}
if type -q pixi
    set -gx PIXI_HOME ~/.pixi
    fish_add_path --move $PIXI_HOME/bin
end
{{- end }}
# Shared uv/rattler cache on /develop (reflinks with project venvs)
set -gx UV_CACHE_DIR /develop/.cache/uv
set -gx PIXI_CACHE_PYPI_WHEELS_DIR /develop/.cache/uv
set -gx PIXI_CACHE_DIR /develop/.cache/rattler
