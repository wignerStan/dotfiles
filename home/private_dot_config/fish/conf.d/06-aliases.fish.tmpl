# ── CLI tool aliases (always available) ───────────────────────
{{- if lookPath "lazygit" }}
alias lg lazygit
{{- end }}
{{- if lookPath "eza" }}
alias ls 'eza --icons --git --group-directories-first'
alias ll 'eza -l --icons --git --group-directories-first'
alias la 'eza -a --icons --git --group-directories-first'
{{- end }}
{{- if lookPath "bat" }}
alias cat 'bat --plain'
alias catp bat
{{- end }}

# ── npm global install redirect (non-work profiles) ────────────
# Reads as "blocked" like the zsh/bash npmrc prefix (.npm-global-blocked);
# the dir is chmod 0500 by run_once_setup (L3).
{{- if not (eq .ownership "work") }}
set -gx NPM_CONFIG_PREFIX "$HOME/.npm-global-blocked"
{{- end }}

# ── Node/Bun dev-facet abbreviations (pnpm/bun installed at L3) ──────
{{- if and (eq .bootstrap "full") (has "dev" .facets) }}
abbr npm pnpm
abbr npx bunx
{{- end }}

