# Jacob's Fish Configuration
# Managed by Chezmoi

if status is-interactive
    # History settings
    history merge # Sync between sessions
    
    # Welcome message
    echo (set_color green)"Welcome back, {{ .name }}"(set_color normal)
end

# Shared Aliases from Chezmoi
{{- range $line := (splitList "\n" (includeTemplate "aliases" .)) }}
{{- if (hasPrefix "alias " $line) }}
{{ $line }}
{{- end }}
{{- end }}

# Set Fisher path if exists
if test -f "$HOME/.config/fish/functions/fisher.fish"
    set -gp fish_function_path "$HOME/.config/fish/functions"
end

# Keep SHELL aligned with the chezmoi-selected primary shell. Fish's
# `fish_path` is not a valid variable; `command -s` is a builtin lookup.
set -l _primary_shell (command -s {{ .primary_shell }})
if test -n "$_primary_shell"
    set -gx SHELL $_primary_shell
end
set -e _primary_shell

# ── CLI wrappers (same as .zshrc) ─────────────────────────────
function cx
    command codex --dangerously-bypass-approvals-and-sandbox $argv
end

function tm
    TERM=xterm-256color command tmux $argv
end

{{- if has "ai" .facets }}
# ── AI facet tool wrappers ───────────────────────────────────
function cc
    term=xterm-256color command claude --settings ~/.claude/settings.org.json $argv
end

function cc2
    term=xterm-256color command claude --disallowedTools "Agent(Plan)" $argv
end

function oc
    OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1 command opencode $argv
end
{{- end }}
