# Pixi config — managed by chezmoi
{{- /* Resolved per-user cache root; empty means user-local caches. */ -}}
{{- $shared_cache := "" -}}
{{- if hasKey . "shared_cache" }}{{- $shared_cache = .shared_cache | default "" -}}{{- end -}}
{{- if $shared_cache }}
# pixi wheels reuse the account-scoped uv cache (same btrfs → reflinks)
[cache]
pypi-wheels = "{{ $shared_cache }}/uv"
{{- end }}

{{- if .use_china_mirrors }}
[repodata-config]
channel-priority = "disabled"
{{- end }}
