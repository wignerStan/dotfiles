# Pixi config — managed by chezmoi
{{- /* Resolved per-user machine profile; empty means user-local caches. */ -}}
{{- $shared := "" -}}
{{- if hasKey . "shared_workspace" }}{{- $shared = .shared_workspace | default "" }}{{- end -}}
{{- if $shared }}
# pixi wheels reuse the shared uv cache (same btrfs → reflinks with project venvs)
[cache]
pypi-wheels = "{{ $shared }}/.cache/uv"
{{- end }}

{{- if .use_china_mirrors }}
[repodata-config]
channel-priority = "disabled"
{{- end }}
