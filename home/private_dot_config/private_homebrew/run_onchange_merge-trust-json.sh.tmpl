{{- /* Homebrew is macOS/Linux only — render empty on Windows so chezmoi skips execution. */ -}}
{{- if ne .chezmoi.os "windows" -}}
#!/bin/bash
# Merge desired Homebrew trusted taps/formulae into ~/.config/homebrew/trust.json.
#
# Unlike a fully-tracked static file, this APPENDS (union) the managed entries to
# whatever is already on disk, so locally-added taps (e.g. via `brew tap`) are
# preserved rather than clobbered. Idempotent and only runs when this script changes.
set -euo pipefail

{{- if lookPath "brew" }}
TRUST=~/.config/homebrew/trust.json
mkdir -p "$(dirname "$TRUST")"
chmod 700 "$(dirname "$TRUST")"

# Managed entries: user/REPO taps and fully-qualified tap/formula trust records.
# sing-box now ships in homebrew/core; the wignerstan/singbox tap was dropped
# (2026-08-08) because brew 6 ignores formula log_path keys on macOS and the
# tap only existed to carry log_path/error_log_path in its service block.
MANAGED_TAPS=$(cat <<'EOF'
EOF
)
MANAGED_FORMULAE=$(cat <<'EOF'
EOF
)

# Retired entries: previously managed, now intentionally removed. Pruned from
# the trust json so stale references do not linger after a tap is dropped.
RETIRED_TAPS=$(cat <<'EOF'
wignerstan/singbox
EOF
)
RETIRED_FORMULAE=$(cat <<'EOF'
wignerstan/singbox/sing-box
EOF
)

if ! command -v jq &>/dev/null; then
    echo "homebrew/trust.json: jq not found, skipping merge" >&2
    exit 0
fi

# Seed an empty trust.json if absent so the merge below always has input.
if [ ! -f "$TRUST" ]; then
    echo '{"trustedtaps":[],"trustedformulae":[]}' > "$TRUST"
fi
chmod 600 "$TRUST"

# Union managed entries into the existing arrays, prune retired ones
# (order preserved, dups removed).
tmp=$(mktemp)
jq --slurpfile taps <(printf '%s\n' "$MANAGED_TAPS" | jq -R . | jq -s .) \
   --slurpfile formulae <(printf '%s\n' "$MANAGED_FORMULAE" | jq -R . | jq -s .) \
   --slurpfile retired_taps <(printf '%s\n' "$RETIRED_TAPS" | jq -R . | jq -s .) \
   --slurpfile retired_formulae <(printf '%s\n' "$RETIRED_FORMULAE" | jq -R . | jq -s .) '
    (.trustedtaps // []) as $t |
    (.trustedformulae // []) as $f |
    {
        trustedtaps:      (($t - $retired_taps[0] - [""]) + ($taps[0] | map(select(length > 0))) | unique),
        trustedformulae:  (($f - $retired_formulae[0] - [""]) + ($formulae[0] | map(select(length > 0))) | unique)
    }
' "$TRUST" > "$tmp"
mv "$tmp" "$TRUST"

echo "homebrew/trust.json: merged managed taps/formulae (additive, retired pruned)"
{{- else if eq .chezmoi.os "windows" -}}
{{- /* no-op on windows */ -}}
{{- else }}
echo "homebrew/trust.json: brew not installed, skipping"
{{- end }}
{{- end -}}
