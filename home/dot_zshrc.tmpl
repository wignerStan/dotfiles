# ═══════════════════════════════════════════════════════════════
# .zshrc — Interactive Shell (managed by chezmoi)
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# Completion system — carapace replaces native zsh completion
# ═══════════════════════════════════════════════════════════════

# Resolve brew prefix (HOMEBREW_PREFIX set in .zshenv; fall back to brew --prefix)
if [[ -n "$HOMEBREW_PREFIX" ]]; then
    _brew_prefix="$HOMEBREW_PREFIX"
elif command -v brew &>/dev/null; then
    _brew_prefix="$(brew --prefix)"
fi

# Carapace: multi-shell completion (replaces zsh-completions + compinit)
if command -v carapace &>/dev/null; then
    autoload -Uz compinit && compinit
    export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
    zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
    source <(carapace _carapace)
else
    # Fallback: native zsh completion when carapace not installed
    if [[ -n "$_brew_prefix" ]]; then
        FPATH="$_brew_prefix/share/zsh-completions:$FPATH"
        FPATH="$_brew_prefix/share/zsh/site-functions:$FPATH"
    fi
    autoload -Uz compinit
    if [[ ! -f ${ZDOTDIR:-$HOME}/.zcompdump ]]; then
        compinit
    else
        compinit -C
    fi
fi

# Brew zsh ships autoloadable helpers (is-at-least, add-zsh-hook) that the
# brew plugins expect. compinit prunes fpath, and the login shell is the
# system /bin/zsh (not brew zsh), so re-add brew's functions dir here —
# AFTER compinit — so the plugins' autoloads resolve. Guarded so a missing
# brew prefix or non-brew host is a silent no-op.
if [[ -n "$_brew_prefix" && -d "${_brew_prefix}/share/zsh/functions" ]]; then
    fpath=("${_brew_prefix}/share/zsh/functions" $fpath)
fi

# Custom zsh functions
fpath=(~/.zsh/functions $fpath)
if [[ -d $HOME/.zsh/functions ]]; then
    for func_file in $HOME/.zsh/functions/*(.N); do
        autoload -Uz -- "$func_file:t"
    done
fi
fpath=($HOME/.zsh/completions $fpath)

ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=10"
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:*:*:*:*' menu select

# ═══════════════════════════════════════════════════════════════
# Plugins (via Homebrew)
# ═══════════════════════════════════════════════════════════════

if [[ -n "$_brew_prefix" ]]; then
    [[ -f $_brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && source $_brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh
    [[ -f $_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && source $_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

    # Fzf (fuzzy finder)
    [[ -f $_brew_prefix/opt/fzf/shell/key-bindings.zsh ]] && source $_brew_prefix/opt/fzf/shell/key-bindings.zsh
    [[ -f $_brew_prefix/opt/fzf/shell/completion.zsh ]] && source $_brew_prefix/opt/fzf/shell/completion.zsh

    # History substring search
    [[ -f $_brew_prefix/share/zsh-history-substring-search/zsh-history-substring-search.zsh ]] && source $_brew_prefix/share/zsh-history-substring-search/zsh-history-substring-search.zsh
fi

# ═══════════════════════════════════════════════════════════════
# Vi mode (native zsh bindkey -v)
# ═══════════════════════════════════════════════════════════════

bindkey -v
export KEYTIMEOUT=1

# Start in insert mode
function zle-line-init() { zle .reset-prompt; }
zle -N zle-line-init

# Readline-style line movement in both modes (matches bash/fish muscle memory)
bindkey -M viins '^a' beginning-of-line
bindkey -M viins '^e' end-of-line
bindkey -M vicmd '^a' beginning-of-line
bindkey -M vicmd '^e' end-of-line

# FZF bindings (both modes) — only when fzf widgets actually loaded
if (( $+functions[fzf-history-widget] )); then
    bindkey -M vicmd '^r' fzf-history-widget
    bindkey -M viins '^r' fzf-history-widget
fi
if (( $+functions[fzf-file-widget] )); then
    bindkey -M vicmd '^t' fzf-file-widget
    bindkey -M viins '^t' fzf-file-widget
fi

# History substring search on arrow keys (both modes) — only when the
# plugin actually loaded (brew zsh-history-substring-search; a missing/
# stale install must degrade to the plain line editor, not error).
if (( $+functions[history-substring-search-up] )); then
    bindkey -M vicmd '^[[A' history-substring-search-up
    bindkey -M vicmd '^[[B' history-substring-search-down
    bindkey -M viins '^[[A' history-substring-search-up
    bindkey -M viins '^[[B' history-substring-search-down
fi

unset _brew_prefix

# ═══════════════════════════════════════════════════════════════
# History
# ═══════════════════════════════════════════════════════════════

HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_SAVE_NO_DUPS

# ═══════════════════════════════════════════════════════════════
# Aliases
# ═══════════════════════════════════════════════════════════════

alias lg="lazygit"
{{- if lookPath "eza" }}
alias ls="eza --icons --git --group-directories-first"
alias ll="eza -l --icons --git --group-directories-first"
alias la="eza -a --icons --git --group-directories-first"
{{- end }}
{{- if lookPath "bat" }}
alias cat="bat --plain"
alias catp="bat"
{{- end }}

# ═══════════════════════════════════════════════════════════════
# CLI tools
# ═══════════════════════════════════════════════════════════════

# Zoxide (smarter cd)
command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"

# Bun completions
{{- if stat (joinPath .chezmoi.homeDir ".bun" "_bun") }}
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
{{- end }}

# Yazi (file manager) shell wrapper
{{- if lookPath "yazi" }}
function y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
}
{{- end }}

# ═══════════════════════════════════════════════════════════════
# Display
# ═══════════════════════════════════════════════════════════════

export BAT_THEME="Solarized (dark)"

export LESS_TERMCAP_mb=$'\E[01;31m'
export LESS_TERMCAP_md=$'\E[01;31m'
export LESS_TERMCAP_me=$'\E[0m'
export LESS_TERMCAP_so=$'\E[01;44;33m'
export LESS_TERMCAP_se=$'\E[0m'
export LESS_TERMCAP_us=$'\E[01;32m'
export LESS_TERMCAP_ue=$'\E[0m'

# ═══════════════════════════════════════════════════════════════
# Prompt — Starship
# ═══════════════════════════════════════════════════════════════
if command -v starship &>/dev/null; then
    eval "$(starship init zsh)"
fi

# Git aliases (from oh-my-zsh git plugin, standalone)
{{- if stat (joinPath .chezmoi.homeDir ".oh-my-zsh/plugins/git/git.plugin.zsh") }}
autoload -Uz is-at-least

function __git_prompt_git() {
  GIT_OPTIONAL_LOCKS=0 command git "$@"
}

function git_current_branch() {
  local ref
  ref=$(__git_prompt_git symbolic-ref --quiet HEAD 2> /dev/null)
  local ret=$?
  if [[ $ret != 0 ]]; then
    [[ $ret == 128 ]] && return
    ref=$(__git_prompt_git rev-parse --short HEAD 2> /dev/null) || return
  fi
  echo ${ref#refs/heads/}
}

source ~/.oh-my-zsh/plugins/git/git.plugin.zsh
{{- end }}

# ═══════════════════════════════════════════════════════════════
# Fastfetch (skip in tmux)
# ═══════════════════════════════════════════════════════════════

if [[ -z "$TMUX" ]]; then
    if command -v fastfetch &>/dev/null; then
        fastfetch
    fi
fi

# iTerm2 Shell Integration
{{- if stat (joinPath .chezmoi.homeDir ".iterm2_shell_integration.zsh") }}
test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"
{{ end }}

# ═══════════════════════════════════════════════════════════════
# Codex wrapper — bypass sandbox/approvals by default
# ═══════════════════════════════════════════════════════════════
cx() {
    command codex --dangerously-bypass-approvals-and-sandbox "$@"
}

# Tmux with compatible terminal
tm() {
    TERM=xterm-256color command tmux "$@"
}

{{- if has "ai" .facets }}
# ── AI facet tool wrappers ────────────────────────────────────
cc() {
    term=xterm-256color command claude --settings ~/.claude/settings.org.json "$@"
}

cc2() {
    term=xterm-256color command claude --disallowedTools "Agent(Plan)" "$@"
}

oc() {
    OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1 command opencode "$@"
}
{{- end }}
