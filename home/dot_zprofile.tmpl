# ═══════════════════════════════════════════════════════════════
# .zprofile — Login shells only (runs once per login session)
# Heavy subshell initializations moved here from .zshenv to avoid
# ~60ms fork tax on every non-interactive zsh invocation.
# ═══════════════════════════════════════════════════════════════

# ── Homebrew (static — PATH already set in .zshenv, just export vars)
{{- $homebrew_repository_path := "" -}}
{{- if hasKey . "homebrew_repository_path" }}{{- $homebrew_repository_path = .homebrew_repository_path | default "" }}{{- end -}}
{{- if eq .chezmoi.os "darwin" }}
export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
export HOMEBREW_REPOSITORY="/opt/homebrew"
{{- else if eq .chezmoi.os "linux" }}
if [[ -n "${HOMEBREW_PREFIX:-}" && -d "$HOMEBREW_PREFIX" ]]; then
    export HOMEBREW_CELLAR="$HOMEBREW_PREFIX/Cellar"
{{- if $homebrew_repository_path }}
    if [[ -d "{{ $homebrew_repository_path }}" ]]; then
        export HOMEBREW_REPOSITORY="{{ $homebrew_repository_path }}"
    else
        export HOMEBREW_REPOSITORY="$HOMEBREW_PREFIX/Homebrew"
    fi
{{- else }}
    export HOMEBREW_REPOSITORY="$HOMEBREW_PREFIX/Homebrew"
{{- end }}
fi
{{- end }}

{{- if eq .bootstrap "full" }}
__mamba_setup="$("$MAMBA_EXE" shell hook --shell zsh --root-prefix "$MAMBA_ROOT_PREFIX" 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__mamba_setup"
else
    alias mamba="$MAMBA_EXE"
fi
unset __mamba_setup
{{- if has "dev" .facets }}
# Activate develop env (separate from base — develop has its own packages)
mamba activate develop 2>/dev/null
{{- end }}
{{- end }}
