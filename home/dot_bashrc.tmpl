# Jacob's Bash Configuration
# Managed by Chezmoi

# Site HPC tools: Lmod, Spack, and modulefile search paths.
[[ -r /etc/profile.d/cakrue-hpc.sh ]] && source /etc/profile.d/cakrue-hpc.sh

# ── Homebrew ──
if [[ -x "$HOME/.linuxbrew/bin/brew" ]]; then
    eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
elif [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [[ -n "${HOMEBREW_PREFIX:-}" && -x "$HOMEBREW_PREFIX/bin/brew" ]]; then
    eval "$("$HOMEBREW_PREFIX/bin/brew" shellenv)"
elif command -v brew &>/dev/null; then
    eval "$(brew shellenv)"
fi

# ── Prompt ──
if command -v starship &>/dev/null; then
    eval "$(starship init bash)"
fi

# ── CD ──
if command -v zoxide &>/dev/null; then
    eval "$(zoxide init bash)"
fi

# ── Carapace completion ──
if command -v carapace &>/dev/null; then
    export CARAPACE_BRIDGES='bash,zsh,fish,inshellisense'
    source <(carapace _carapace bash)
fi

# ── Aliases (from shared template) ──
{{- range $line := (splitList "\n" (includeTemplate "aliases" .)) }}
{{- if (hasPrefix "alias " $line) }}
{{ $line }}
{{- end }}
{{- end }}

# ── History ──
export HISTSIZE=100000
export HISTFILESIZE=100000
export HISTCONTROL=ignoreboth:erasedups
shopt -s histappend

# ── fzf ──
if command -v fzf &>/dev/null; then
    eval "$(fzf --bash 2>/dev/null)"
fi
